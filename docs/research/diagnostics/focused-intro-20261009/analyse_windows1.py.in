"""Passive post-drain QPC window accounting. Never invokes a target or tool."""
from bisect import bisect_right
from collections import Counter
import hashlib
import json
from pathlib import Path

from per_vi_log import parse, interval

OUT=Path(__file__).resolve().parent
CASE=OUT/'title-focused-c2-1'


def pin(path):
    path=Path(path).resolve()
    data=path.read_bytes()
    return dict(path=str(path),bytes=len(data),sha256=hashlib.sha256(data).hexdigest())


def save(name,value):
    with (CASE/name).open('x',encoding='utf8') as stream:
        json.dump(value,stream,indent=2)
        stream.write('\n')


def select(events,start,end):
    """Only wholly contained suspend brackets qualify; never midpoint guessing."""
    certain=[]; ambiguous=[]
    for event in events:
        lo,hi=event['qpc_before_suspend'],event['qpc_after_resume']
        if lo>=start and hi<end:
            certain.append(event)
        elif lo<end and hi>=start:
            ambiguous.append(event)
    return certain,ambiguous


def main():
    result=json.loads((CASE/'result.json').read_bytes())
    assert result['status']=='PASS' and result['row']['drained'] and result['row']['exit_code']==0
    assert all(result['checks'].values()) and result['error'] is None and not result['timing_eligible']
    raw_path=CASE/'native-rip.json'
    raw_pin=result['native_sampler']
    assert Path(raw_pin['path']).resolve()==raw_path.resolve() and raw_path.stat().st_size==raw_pin['bytes']
    report=json.loads(raw_path.read_bytes())
    log_path=CASE/'logs/0.log'
    assert pin(log_path)==result['row']['log']
    timer=parse(log_path.read_text(encoding='utf8'))
    assert timer==json.loads((CASE/'per-vi.json').read_bytes())
    events=report['sample_events']; frequency=report['qpc_frequency']
    assert report['errors']==[] and report['stop_reason']=='requested' and not report['fatal_owned_resume_failure']
    assert len(events)==report['samples']==report['attempts']==5231
    assert frequency==timer['begin']['qpc_frequency']
    assert timer['begin']['owner']==report['tid']==result['row']['metrics']['owned_target_tid']
    assert all(e['sequence']==i and e['qpc_before_suspend']<=e['qpc_after_resume'] for i,e in enumerate(events))
    assert all(a['qpc_after_resume']<=b['qpc_before_suspend'] for a,b in zip(events,events[1:]))
    assert Counter(e['rip'] for e in events)==Counter({int(r['rip'],0):r['count'] for r in report['addresses']})
    by_rip={int(row['rip'],0):row for row in report['addresses']}
    candidates=[interval(timer,start,start+30) for start in range(750,1471)]
    worst_wall=max(candidates,key=lambda x:x['metrics']['qpc_ticks'])
    worst_cpu=max(candidates,key=lambda x:x['metrics']['cpu_100ns'])
    windows=[('fixed_old_peak',939,974),('fixed_sustained_slowdown',831,1351),
             ('actual_wall_worst_30vi',worst_wall['start'],worst_wall['end']),
             ('actual_cpu_worst_30vi',worst_cpu['start'],worst_cpu['end'])]
    output=[]
    for name,start,end in windows:
        value=interval(timer,start,end)
        a,b=timer['rows'][start],timer['rows'][end]
        selected,ambiguous=select(events,a['qpc'],b['qpc'])
        counts=Counter(e['rip'] for e in selected)
        raw=[]
        for rip,count in counts.most_common():
            row=by_rip[rip]
            raw.append(dict(rip=hex(rip),samples=count,rva=row['rva'],module=row['module'],ambiguous_module=row['ambiguous_module']))
        wall=value['metrics']['wall_seconds']; cpu=value['metrics']['cpu_seconds']
        output.append(dict(name=name,**value,
            main_thread_busy_cpu_over_wall=cpu/wall,
            vi_services_per_wall_second=(end-start)/wall,
            qpc_start=a['qpc'],qpc_end=b['qpc'],
            certainly_inside_samples=len(selected),boundary_bracket_ambiguous_samples=len(ambiguous),
            ambiguous_event_sequences=[e['sequence'] for e in ambiguous],raw_rip_frequency=raw))
    rows=timer['rows']; qpcs=[row['qpc'] for row in rows]
    assignments=[]
    for e in events:
        lo=bisect_right(qpcs,e['qpc_before_suspend'])-1
        hi=bisect_right(qpcs,e['qpc_after_resume'])-1
        assignments.append(dict(sequence=e['sequence'],rip=hex(e['rip']),
                                earliest_boundary_index=lo,latest_boundary_index=hi,
                                wholly_in_one_vi_interval=lo==hi))
    singles=[interval(timer,start,start+1) for start in range(750,1500)]
    save('event-vi-assignment1.json',dict(qpc_frequency=frequency,events=assignments,
        policy='QPC bracket endpoints only. Equal/catch-up QPC rows and brackets crossing a boundary remain explicit; no guessed interruption instant.'))
    preparation=json.loads((OUT/'preparation1.json').read_bytes())
    conclusion=dict(
        status='PASS_PASSIVE_EXACT_QPC_WINDOW_COUNTS_NAMES_PENDING',
        scope='One root-owned visible2b9+C2 diagnostic. Sampling/perVI overhead included; no speed or exclusive-time claim.',
        inputs=[pin(p) for p in (__file__,OUT/'preparation1.json',OUT/'per_vi_log.py',CASE/'result.json',log_path,CASE/'per-vi.json')],
        accepted_native_rip_pin=raw_pin,raw_identity='Accepted original result pin/size; not redundantly rehashed here.',
        qpc_frequency=frequency,samples=len(events),sparse_stacks=len(report['stack_snapshots']),
        actual_trigger_retraces=dict(start=result['row']['metrics']['native_sampler_start_retrace'],stop=result['row']['metrics']['native_sampler_stop_retrace']),
        max_capture_bracket_ms=max(e['qpc_after_resume']-e['qpc_before_suspend'] for e in events)*1000/frequency,
        max_observed_suspend_ms=report['suspend_max_ms'],
        windows=output,
        worst30_search=dict(domain=[750,1500],candidate_starts=len(candidates),tie_policy='Earliest start; wall and CPU maxima selected independently. Exploratory diagnostic, not a gain gate.'),
        longest_single_vi_wall=max(singles,key=lambda x:x['metrics']['qpc_ticks']),
        largest_single_vi_cpu=max(singles,key=lambda x:x['metrics']['cpu_100ns']),
        per_vi_bracket_ambiguous_samples=sum(not r['wholly_in_one_vi_interval'] for r in assignments),
        calibration_cpu_step_unresolved=timer['calibration_cpu_step_unresolved'],calibration_span=timer['calibration_span'],
        naming=dict(status='NOT_EXECUTED_AWAIT_ROOT_TOOL_REVIEW',selected_host=preparation['selected_host'],
                    selected_host_pdb=preparation['selected_host_pdb'],
                    c2_map=preparation['c2_map'],c2_map_proof=preparation['c2_map_proof'],
                    stale_copied_tester_pdb_must_not_be_used=True),
        limitations=['VI service intervals include catch-up, waits and sampler pauses; they are not presented frames.',
                    'All counts are interrupted main-thread RIP frequencies; per-window CPU/cycles are not allocated to individual RIPs.',
                    'Old peak positions are fixed diagnostic windows; actual worst30VI is a separately labeled exploratory selection.',
                    'GetThreadTimes100ns units do not establish timer resolution. No calibration or sampler overhead is subtracted.',
                    'Exact2b9 PDB and qualifiedC2 MAP naming remain separate bounded offline work, never the stale tester7c32 PDB.'])
    save('window-summary1.json',conclusion)
    print(json.dumps(dict(output=pin(CASE/'window-summary1.json'),
                          samples=len(events),sparse_stacks=len(report['stack_snapshots']),
                          windows=[{k:w[k] for k in ('name','start','end','metrics','main_thread_busy_cpu_over_wall','certainly_inside_samples','boundary_bracket_ambiguous_samples')} for w in output]),indent=2))


if __name__=='__main__':
    main()
