+from pathlib import Path
+import argparse,contextlib,importlib.util,io,json,sys
+p=argparse.ArgumentParser();p.add_argument('project',type=Path);p.add_argument('certified_chunks',type=Path);a=p.parse_args()
+script=a.project/'scripts/windows/native_entries.py';sys.path.insert(0,str(script.parent))
+s=importlib.util.spec_from_file_location('gx_watch_certifier',script);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)
+chunks=list(a.certified_chunks.glob('chunk_*.c'));assert chunks
+selected={0x802D85F8,0x802D80D0,0x802AFBD4};assert selected<=m.certify(chunks,set())
+for at in (0x80328F30,0x80328F3C,0x80328F40,0x80328F7C,0x80328F88,0x80328F8C):
