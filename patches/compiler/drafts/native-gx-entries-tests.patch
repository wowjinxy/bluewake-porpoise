+typedef struct Harness {
+    HMODULE lib;
+    const StaticRecompModuleDesc* mod;
+    CPUState fallback;
+    BlueWakeModuleStorage storage;
+    SetPipeFn set_pipe;
+    SetPipeBytesFn set_pipe_bytes;
