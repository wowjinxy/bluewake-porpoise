+        c->gpr[3] = pointer(OBJ, 0x1000u, 4u);
+        c->gpr[4] = pointer(OBJ + 0x1000u, 0x0F00u, 4u);
+        c->gpr[5] = below(8u) == 0u ? below(256u) : below(8u);
+        break;
+    case BLUEWAKE_GX_LOAD_TEX_OBJ:
+        c->gpr[3] = pointer(OBJ, 0x1000u, 4u);
+        c->gpr[4] = below(8u) == 0u ? below(256u) : below(8u);
+        break;
+    case BLUEWAKE_GX_SET_MATRIX_INDEX:
+        c->gpr[3] = below(8u) == 0u ? below(256u) : below(12u);
+        break;
+    case 0x80322604u: /* GXSetTexCoordGen2(dst, func, src, mtx, normalize, postmtx) */
+        c->gpr[3] = below(8u) == 0u ? below(256u) : below(9u);
+        c->gpr[4] = below(8u) == 0u ? below(256u) : below(12u);
+        c->gpr[5] = below(8u) == 0u ? below(256u) : below(22u);
+        c->gpr[6] = below(4u) == 0u ? 60u : 30u + 3u * below(12u);
+        c->gpr[8] = below(4u) == 0u ? 125u : 64u + 3u * below(21u);
+        break;
+    case 0x80324390u: /* GXSetChanAmbColor(chan, color) */
+    case 0x80324484u: /* GXSetChanMatColor */
+        c->gpr[3] = below(8u) == 0u ? below(256u) : below(7u);
+        c->gpr[4] = pointer(OBJ, 0x1F00u, below(2u) ? 4u : 1u);
+        break;
+    case 0x80324B68u: /* GXInitTexObjLOD(obj, ...) */
+        c->gpr[3] = pointer(OBJ, 0x1F00u, 4u);
+        break;
+    case 0x803265A8u: /* GXSetFog(type, startz, endz, nearz, farz, color) */
+    case 0x802D85F8u: /* J3DGDSetFog */
+    case 0x802AFBD4u: /* GFSetFog */
+        /* A scene's fog mostly: start before end, near before far. */
+        if (below(4u) != 0u) {
+            const f32 start = (f32)(next() % 100000u) * 0.01f, end = start + 1.0f + (f32)(next() % 500000u) * 0.01f;
+            const f32 nearz = 0.1f + (f32)(next() % 10000u) * 0.01f, farz = nearz + 10.0f + (f32)(next() % 5000000u) * 0.01f;
+            c->fpr[1] = start;
+            c->fpr[2] = end;
+            c->fpr[3] = nearz;
+            c->fpr[4] = farz;
+        }
+        /* fall through: the colour */
+    case 0x802AFDDCu: /* GFSetTevColor(reg, color) */
+    case 0x802AFE38u: /* GFSetTevColorS10 */
+        c->gpr[4] = pointer(OBJ, 0x1F00u, below(2u) ? 4u : 1u);
+        break;
+    case 0x80326758u: /* GXSetFogRangeAdj(enable, center, table) */
+        c->gpr[5] = pointer(OBJ, 0x1F00u, 2u);
+        break;
+    case 0x80325810u: /* GXSetIndTexMtx(id, offset matrix, scale) */
+        c->gpr[4] = pointer(OBJ, 0xF00u, 4u);
+        if (c->gpr[4] - OBJ < 0xF00u)
+            for (u32 i = 0; i < 6u; ++i)
+                put32(ram, (c->gpr[4] & ~3u) + 4u * i, any_single(2u));
+        break;
+    default:
+        break;
+    }
+    /* Texture objects: the TLUT name small mostly, so the callback's region is in __GXData. */
+    if (n->entry == BLUEWAKE_GX_LOAD_TEX_OBJ || n->entry == BLUEWAKE_GX_LOAD_TEX_OBJ_PRELOADED) {
+        const u32 obj = c->gpr[3] & ~3u;
+        if (obj >= OBJ && obj + 32u <= OBJ + 0x2000u) {
+            put32(ram, obj + 24u, below(16u) == 0u ? (below(2u) ? next() : 20u + below(4u)) : below(20u));
+            if (below(2u) != 0u)
+                put8(ram, obj + 31u, (u8)(next() & ~2u)); /* the TLUT path */
+        }
+    }
+    /* A reservation, sometimes on a granule the function stores to. */
+    if (c->reserve_valid) {
+        switch (below(4u)) {
+        case 0: c->reserve_addr = c->gpr[1] - 8u * below(8u); break;
+        case 1: c->reserve_addr = GXD + 4u * below(0x140u); break;
+        case 2: c->reserve_addr = OBJ + 4u * below(0x800u); break;
+        default: break;
+        }
+        if (below(4u) == 0u)
+            c->reserve_addr |= 0x40000000u;
+    }
+    clock_edges(c, scenario, n->shortest);
+    k.pipe = random_pipe(scenario);
+    k.journal = scenario % 41u == 7u;
+    k.aliases = scenario % 43u == 8u;
+    k.flush = below(4u) == 0u;
+    k.must_decline = k.journal || k.aliases || c->exception != 0u || k.pipe.mode != PIPE_BATCH;
+    if(scenario>=48000u && scenario<60000u &&
+       (n->entry==BLUEWAKE_GX_LOAD_TEX_OBJ || n->entry==BLUEWAKE_GX_LOAD_TEX_OBJ_PRELOADED)) {
+        /* Explicit ordinary positives complement48k unchanged random cases.
+         * Vary all8 maps and all20 valid TLUT IDs; both texture paths retain
+         * random object/register contents outside their validated fields. */
+        c->gpr[1]=STACK+0x1000u;c->gpr[2]=R2;c->gpr[13]=R13;
+        c->gpr[3]=OBJ;c->gpr[4]=n->entry==BLUEWAKE_GX_LOAD_TEX_OBJ ? scenario%8u : OBJ+0x1000u;
+        c->gpr[5]=scenario%8u;c->cycle_budget=100000;c->downcount=0;
+        c->cycle_deadline_budget=0;c->exception=0;c->msr|=PPC_MSR_FP;
+        put32(ram,R2-12848u,GXD);put32(ram,GXD+1040u,0x8031FA48u);
+        put32(ram,GXD+1044u,0x8031FAC4u);put32(ram,OBJ+24u,scenario%20u);
+        put8(ram,OBJ+31u,(u8)((scenario&1u) ? 2u : 0u));
+        k.pipe.mode=PIPE_BATCH;k.pipe.prefill=0;k.journal=k.aliases=k.flush=k.must_decline=false;
+        k.positive_texture=true;
+    }
+    return k;
+}
+
+/* Host scenarios: busy (the module asks its edge service at every boundary
+ * too), the filter off or a boundary watched (the natives' own view only). */
+enum { HOST_QUIET, HOST_BUSY, HOST_FILTER_OFF, HOST_WATCHED };
+
+static unsigned host_scenario(unsigned scenario) {
+    switch (scenario % 37u) {
+    case 5: return HOST_BUSY;
+    case 11: return HOST_FILTER_OFF;
+    case 17: return HOST_WATCHED;
+    default: return HOST_QUIET;
+    }
+}
+
+static void set_host(unsigned host) {
+    reset_host();
+    if (host == HOST_BUSY)
+        s_sources_dirty = true;
+    if (host == HOST_FILTER_OFF)
+        bw_edge_filter_enabled = false;
+    if (host == HOST_WATCHED) {
+        watch(0x8031FA48u); /* GXLoadTexObj's region callback */
+        watch(0x80324F14u);
+        watch(0x8031FAC4u); /* PreLoaded's TLUT callback */
+        watch(0x80325CD4u); /* GXBegin's __GXUpdateBPMask */
+        watch(0x803214B0u); /* and __GXXfVtxSpecs */
+    }
+}
+
+static bool gate_allow=true;
+static unsigned gate_queries;
+static u32 gate_refuse_at, gate_change_alias_at;
+static u32 gate_reenter_at;
+static unsigned gate_reentry_refusals;
+static bool gate_probe_active;
+static CPUState gate_probe_initial;
+static unsigned gate_probe_seen;
+static const u32 gate_probe_pcs[4]={0x80328F30u,0x802D80E4u,0x80328F7Cu,0x802D824Cu};
+static s64 gate_probe_previous_count;
+static bool gate_callback(void* user,const CPUState* cpu,u32 address) {
+    (void)user;++gate_queries;
+    if(gate_probe_active) {
+        for(unsigned i=0;i<4;++i) if(address==gate_probe_pcs[i]) {
+            if(i!=gate_probe_seen || cpu->pc!=address ||
+               cpu->gpr[1]!=gate_probe_initial.gpr[1]-48u ||
+               cpu->gpr[11]!=gate_probe_initial.gpr[1]) abort();
+            if(i==0 && (cpu->downcount!=-5 || cpu->lr!=0x802D80E4u)) abort();
+            if(i==1 && (cpu->downcount!=gate_probe_previous_count-8 || cpu->cycle_observation_suffix!=0)) abort();
+            if(i==2 && cpu->lr!=0x802D824Cu) abort();
+            if(i==3 && (cpu->downcount!=gate_probe_previous_count-8 || cpu->cycle_observation_suffix!=0)) abort();
+            if(i<2 || i==3) for(unsigned r=25;r<32;++r)
+                if(cpu->gpr[r]!=gate_probe_initial.gpr[r]) abort();
+            gate_probe_previous_count=cpu->downcount;++gate_probe_seen;
+        }
+    }
+    if(address==gate_reenter_at) {
+        if(bluewake_native_gx((CPUState*)(uintptr_t)1,BLUEWAKE_GX_SET_ARRAY)) abort();
+        ++gate_reentry_refusals;
+    }
+    if(address==gate_change_alias_at) ++g_ppc_guest_alias_generation;
+    return gate_allow && address!=gate_refuse_at;
+}
+static int native_gx(CPUState* cpu,u32 address) {
+    if(!bluewake_composite_native_entries_v1(true,gate_callback,NULL)) abort();
+    return bluewake_native_entries_try(cpu,address);
+}
+static void admission_checks(void) {
+    gate_queries=0;
+    if(bluewake_composite_native_entries_v1(false,gate_callback,NULL) ||
+       bluewake_native_entries_try((CPUState*)(uintptr_t)1,BLUEWAKE_GX_SET_ARRAY) || gate_queries) abort();
+    if(bluewake_composite_native_entries_v1(true,NULL,NULL) ||
+       bluewake_native_entries_try((CPUState*)(uintptr_t)1,BLUEWAKE_GX_SET_ARRAY) || gate_queries) abort();
+    gate_allow=false;
+    if(!bluewake_composite_native_entries_v1(true,gate_callback,NULL) ||
+       bluewake_native_entries_try((CPUState*)(uintptr_t)1,BLUEWAKE_GX_SET_ARRAY) || gate_queries!=1) abort();
+    gate_allow=true;
+}
+static void targeted_checks(Harness* h) {
+    CPUState c;memset(&c,0,sizeof c);c.ram=h->native_ram;c.ram_size=GC_MAIN_RAM_SIZE;
+    c.gpr[1]=STACK+0x1000u;c.gpr[2]=R2;c.gpr[13]=R13;
+    c.gpr[3]=0;c.gpr[4]=OBJ;c.gpr[5]=16;
+    c.pc=BLUEWAKE_GX_SET_ARRAY;c.lr=RETURN_ADDRESS;c.cycle_budget=100000;
+    put32(c.ram,R2-12848u,GXD);reset_host();
+    PipeCase pipe={PIPE_BATCH,0};
+    if(!harness_case(h,native_gx,c.pc,"GXSetArray finite control",0,&c,&pipe,false,false,false,false)) abort();
+    static const s64 budgets[8]={0,-1,INT64_MIN,INT64_MAX,(s64)INT32_MAX+1,1000,1000,1000};
+    static const s64 counts[8]={0,0,0,-INT64_MAX+1,-(s64)INT32_MAX,INT64_MIN,1,-1000};
+    for(unsigned i=0;i<8;++i) {
+        CPUState p=c;p.cycle_budget=budgets[i];p.downcount=counts[i];
+        if(harness_case(h,native_gx,p.pc,"extreme/spent counter refusal",i,&p,&pipe,true,false,false,false)) abort();
+    }
+    pipe.prefill=BW_GATHER_PIPE_BATCH-1u;
+    if(harness_case(h,native_gx,c.pc,"partial RAM store before FIFO-capacity refusal",0,&c,&pipe,true,false,false,false)) abort();
+    pipe.prefill=0;
+    u8 alias[32];memset(alias,0x5A,sizeof alias);
+    if(!ppc_guest_alias_add_shared(0xCC008000u,sizeof alias,alias)) abort();
+    if(harness_case(h,native_gx,c.pc,"registered pipe alias refusal",0,&c,&pipe,true,false,false,false)) abort();
+    for(unsigned i=0;i<sizeof alias;++i) if(alias[i]!=0x5A) abort();
+    if(!ppc_guest_alias_remove(0xCC008000u,sizeof alias)) abort();
+    CPUState p=c;p.ram=(u8*)&p;p.ram_size=sizeof p;CPUState before=p;
+    if(native_gx(&p,p.pc)||memcmp(&p,&before,sizeof p)) abort();
+    const unsigned old_mxcsr=_mm_getcsr();_mm_setcsr(old_mxcsr&~0x80u);
+    CPUState unmasked=c,unmasked_before=c;copy_regions(h->before,c.ram);
+    if(native_gx(&unmasked,c.pc) || memcmp(&unmasked,&unmasked_before,sizeof unmasked) ||
+       !same_regions(h->before,c.ram)) abort();
+    if(_mm_getcsr()!=(old_mxcsr&~0x80u)) abort();_mm_setcsr(old_mxcsr);
+    CPUState gd=c;gd.pc=0x802D80D0u;gd.gpr[3]=0;gd.gpr[4]=0;gd.gpr[5]=1;
+    gd.gpr[6]=0;gd.gpr[7]=1;gd.gpr[8]=0;gd.gpr[9]=0;
+    for(unsigned r=25;r<32;++r)gd.gpr[r]=0xA0000000u+r;
+    put32(gd.ram,R13-25656u,GDL);
+    put32(gd.ram,GDL,OBJ+0x1000u);put32(gd.ram,GDL+4u,0x400u);
+    put32(gd.ram,GDL+8u,OBJ+0x1000u);put32(gd.ram,GDL+12u,OBJ+0x1400u);
+    gate_probe_initial=gd;gate_probe_seen=0;gate_probe_active=true;
+    if(!harness_case(h,native_gx,gd.pc,"original save/restore finite control",0,&gd,&pipe,false,false,false,false) || gate_probe_seen!=4) abort();
+    gate_probe_active=false;
+    gate_reentry_refusals=0;gate_reenter_at=gate_probe_pcs[0];
+    if(!harness_case(h,native_gx,gd.pc,"reentry rejects inaccessible CPU before fields",0,&gd,&pipe,false,false,false,false) || gate_reentry_refusals!=1) abort();
+    gate_reenter_at=0;
+    for(unsigned i=0;i<4;++i) {
+        gate_refuse_at=gate_probe_pcs[i];
+        if(harness_case(h,native_gx,gd.pc,"fresh save/restore boundary refusal",i,&gd,&pipe,true,false,false,false)) abort();
+    }
+    gate_refuse_at=0;
+    for(unsigned i=0;i<4;++i) {
+        reset_host();watch(gate_probe_pcs[i]);
+        if(harness_case(h,native_gx,gd.pc,"actual watched save/restore boundary refusal",i,&gd,&pipe,true,false,false,false)) abort();
+    }
+    reset_host();
+    const u32 alias_before=g_ppc_guest_alias_generation;gate_change_alias_at=gate_probe_pcs[0];
+    if(harness_case(h,native_gx,gd.pc,"changed alias generation after true query",0,&gd,&pipe,true,false,false,false)) abort();
+    gate_change_alias_at=0;g_ppc_guest_alias_generation=alias_before;
+    printf("GX guards: 3 exact finite controls (one inaccessible-CPU reentry), 8 counter refusals, partial-store rollback, pipe-alias/CPU-overlap/unmasked-SSE refusals, 4 current save/restore probes, 4 boundary predicate refusals, 4 actual watched-boundary refusals, true-query alias-change refusal\n");
+}
+
+static const char* s_only;
+static bool skip(const Native* n) {
+    if (s_only == NULL)
+        return false;
+    if (s_only[0]=='0' && s_only[1]=='x') {
+        char* end=NULL;const unsigned long selected=strtoul(s_only+2,&end,16);
+        if(end!=s_only+10 || *end!='\0') abort();
+        return n->entry!=(u32)selected;
+    }
+    for (const char* p = s_only; *p != 0;) { /* name prefixes, comma-separated */
+        const char* end = strchr(p, ',');
+        const size_t length = end != NULL ? (size_t)(end - p) : strlen(p);
+        if (length != 0u && strncmp(n->name, p, length) == 0)
+            return false;
+        p += length + (end != NULL);
+    }
+    return true;
+}
+
+/* --- The microbenchmark: ordinary inputs, the budget large. -------------- */
+
+/* The J3DGD natives write a GD list: each benchmark call starts on the case's
+ * list again (both sides), so the list never fills. */
+static u8 s_bench_gdl[16];
+static bool s_bench_gd;
+static void bench_gd_reset(u8* ram) {
+    if (s_bench_gd)
+        memcpy(ram + (GDL - GC_RAM_BASE), s_bench_gdl, sizeof s_bench_gdl);
+}
+
+static void bench(Harness* h, unsigned calls) {
+    h->set_pipe(sink_word);
+    h->set_pipe_bytes(sink_bytes);
+    bluewake_composite_set_gather_pipe(sink_word);
+    bluewake_composite_set_gather_pipe_bytes(sink_bytes);
+    reset_host();
+    u8* ram = h->native_ram;
+    for (unsigned which = 0; which < NATIVE_COUNT; ++which) {
+        const Native* n = &k_natives[which];
+        if (skip(n))
+            continue;
+        for (unsigned variant = 0; variant < 1u; ++variant) {
+            Case k;
+            unsigned tries = 0;
+            /* A case the native runs, quiet. */
+            do {
+                k = build(ram, which, 6u * (tries + 1u));
+                k.cpu.exception = 0;
+                k.cpu.downcount = 0;
+                k.cpu.cycle_budget = (s64)1 << 40;
+                k.cpu.cycle_deadline_budget = 0;
+                k.cpu.reserve_valid = false;
+                put32(ram, GXD + 1268u, variant ? 0x3Fu : 0u);
+                if (n->entry == BLUEWAKE_GX_LOAD_TEX_OBJ || n->entry == BLUEWAKE_GX_LOAD_TEX_OBJ_PRELOADED)
+                    put8(ram, (k.cpu.gpr[3] & ~3u) + 31u, 2u); /* no TLUT */
+                CPUState probe = k.cpu;
+                copy_regions(h->before, ram);
+                set_test_pipe(PIPE_BATCH);
+                bw_gather_pipe_length = 0;
+                const int ran = bluewake_native_gx(&probe, n->entry);
+                copy_regions(ram, h->before);
+                if (ran)
+                    break;
+            } while (++tries < 1000u);
+            if (tries == 1000u) {
+                printf("%08X %s: no benchmark case\n", n->entry, n->name);
+                continue;
+            }
+            const CPUState base = k.cpu;
+            s_bench_gd = n->entry - 0x802D0000u < 0x20000u;
+            memcpy(s_bench_gdl, ram + (GDL - GC_RAM_BASE), sizeof s_bench_gdl);
+            bluewake_composite_set_gather_pipe(sink_word); /* the probe set the logging pipe */
+            bluewake_composite_set_gather_pipe_bytes(sink_bytes);
+            bw_gather_pipe_length = 0;
+            copy_regions(h->before, ram);
+            double best_t = 1e30, best_n = 1e30;
+            for (unsigned round = 0; round < 5u; ++round) {
+                copy_regions(h->reference_ram, h->before);
+                CPUState* g = h->storage.cpu;
+                *g = base;
+                g->ram = h->reference_ram;
+                h->mod->on_state_loaded(g);
+                double t0 = now_ns();
+                for (unsigned i = 0; i < calls; ++i) {
+                    g->gpr[1] = base.gpr[1];
+                    memcpy(&g->gpr[3], &base.gpr[3], 4u * sizeof(u32));
+                    memcpy(&g->fpr[1], &base.fpr[1], 4u * sizeof base.fpr[0]); /* the FP arguments */
+                    g->lr = RETURN_ADDRESS;
+                    if (variant)
+                        put32(h->reference_ram, GXD + 1268u, 0x3Fu);
+                    bench_gd_reset(h->reference_ram);
+                    g->pc = n->entry;
+                    h->mod->dispatch(g, n->entry);
+                }
+                const double t = (now_ns() - t0) / calls;
+                CPUState native = base;
+                t0 = now_ns();
+                for (unsigned i = 0; i < calls; ++i) {
+                    native.gpr[1] = base.gpr[1];
+                    memcpy(&native.gpr[3], &base.gpr[3], 4u * sizeof(u32));
+                    memcpy(&native.fpr[1], &base.fpr[1], 4u * sizeof base.fpr[0]);
+                    native.lr = RETURN_ADDRESS;
+                    if (variant)
+                        put32(ram, GXD + 1268u, 0x3Fu);
+                    bench_gd_reset(ram);
+                    native.pc = n->entry;
+                    if (!bluewake_native_gx(&native, n->entry)) {
+                        printf("%08X %s: the benchmark case declined\n", n->entry, n->name);
+                        break;
+                    }
+                    bw_gather_pipe_drain();
+                }
+                const double d = (now_ns() - t0) / calls;
+                if (t < best_t)
+                    best_t = t;
+                if (d < best_n)
+                    best_n = d;
+            }
+            copy_regions(ram, h->before);
+            printf("%08X %s%s: translation %.1f ns/call through the dispatcher, native %.1f ns/call (%.2fx)\n",
+                   n->entry, n->name, variant ? " (dirty: every callee)" : "", best_t, best_n, best_t / best_n);
+#ifdef NATIVE5_HOOKED
+            hooked_bench(h, ram, n->entry, &base, calls, n->name, variant);
+#endif
+            fflush(stdout);
+        }
+    }
+}
+
+int main(int argc, char** argv) {
+    admission_checks();
+    bluewake_native_gate_enabled = 0; /* every call tried */
+    if (argc < 2) {
+        fprintf(stderr, "usage: native_gx_test MODULE.dll [CASES_PER_FUNCTION] [BENCH_CALLS]\n");
+        return 2;
+    }
+    const unsigned cases = argc > 2 ? (unsigned)strtoul(argv[2], NULL, 10) : 60000u;
+    const unsigned bench_calls = argc > 3 ? (unsigned)strtoul(argv[3], NULL, 10) : 1000000u;
+    /* A fourth argument: only the natives whose names start with one of its
+     * comma-separated prefixes. */
+    s_only = argc > 4 ? argv[4] : NULL;
+    Harness h;
+    if (!harness_load(&h, argv[1], false, k_regions, sizeof k_regions / sizeof k_regions[0]))
+        return 1;
+    targeted_checks(&h);
+    int failed = 0;
+    for (unsigned which = 0; which < NATIVE_COUNT; ++which) {
+        const Native* n = &k_natives[which];
+        if (skip(n))
+            continue;
+        unsigned ran = 0, declined = 0, positive_texture = 0;
+        s_flushed_inside = 0;
+        for (unsigned i = 0; i < cases; ++i) {
+            Case k = build(h.native_ram, which, i);
+            const unsigned host = k.positive_texture ? HOST_QUIET : host_scenario(i);
+            set_host(host);
+            const bool must = k.must_decline || (n->boundaries && (host == HOST_BUSY || host == HOST_FILTER_OFF));
+            const int r = harness_case(&h, native_gx, n->entry, n->name, i, &k.cpu, &k.pipe, must, k.journal,
+                                       k.aliases, k.flush);
+            if(k.positive_texture) {
+                if(!r) { fprintf(stderr,"explicit finite texture positive declined at%u\n",i);return 1; }
+                ++positive_texture;
+            }
+            if (r && (host == HOST_FILTER_OFF || host == HOST_WATCHED)) {
+                /* It ran with the filter off (its path must have crossed no
+                 * boundary) or with the callbacks' and callees' boundaries
+                 * watched (it must have crossed none of those). With the host
+                 * busy, the translation asks its edge service at the first
+                 * boundary it crosses. */
+                s_sources_dirty = true;
+                (void)harness_translate(&h, &k.cpu, n->entry);
+                s_sources_dirty = false;
+                if (s_unexpected_service != 0u &&
+                    (host == HOST_FILTER_OFF || !bw_edge_unwatched(s_unexpected_at))) {
+                    fprintf(stderr, "case %u (%s): ran across a boundary (%08X) with the filter off or it watched\n",
+                            i, n->name, s_unexpected_at);
+                    return 1;
+                }
+            }
+            ran += (unsigned)r;
+            declined += (unsigned)(r == 0);
+        }
+        reset_host();
+        printf("%08X %s: %u cases, %u identical (%llu handing the batch over before its bytes), "
+               "%u declined unchanged, 0 mismatches\n",
+               n->entry, n->name, cases, ran, s_flushed_inside, declined);
+        fflush(stdout);
+        if(n->entry==BLUEWAKE_GX_LOAD_TEX_OBJ || n->entry==BLUEWAKE_GX_LOAD_TEX_OBJ_PRELOADED) {
+            if(positive_texture!=12000u) { fprintf(stderr,"finite texture positive count mismatch\n");return 1; }
+            printf("Explicit finite texture variants compared: %u (48k random cases retained)\n",positive_texture);
+        }
+        if(n->entry==0x802D85F8u) {
+            if(s_resumed_save29!=ran) { fprintf(stderr,"save29 continuation count mismatch\n");return 1; }
+            printf("J3D fog genuine save29 edge returns resumed by ordinary dispatch: %llu\n",s_resumed_save29);
+        }
+        if (ran < 30000u && cases >= 60000u) {
+            printf("  fewer than 30,000 compared cases\n");
+            failed = 1;
+        }
+    }
+#ifdef NATIVE5_HOOKED
+    hooked_summary();
+#endif
+    /* Per-entry accepted/declined counts above are the fixture receipt. */
+    if (bench_calls != 0u)
+        bench(&h, bench_calls);
+    return failed;
+}
