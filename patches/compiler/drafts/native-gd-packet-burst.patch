diff --git a/experiments/gd-packet-burst/native_gd.c b/experiments/gd-packet-burst/native_gd.c
new file mode 100644
index 0000000..68c4153
--- /dev/null
+++ b/experiments/gd-packet-burst/native_gd.c
@@ -0,0 +1,87 @@
+/* Experimental RAM display-list packet coalescing, GZLE01.
+ * The original function retains its prologue, color packing, overflow check
+ * and optional overflow callback. This replaces only its unpaid 64-cycle
+ * suffix at 802D82C8. All failure paths leave CPU and guest memory unchanged.
+ * A versioned native-entry observer predicate must approve the suffix first.
+ *
+ * Whole-span raw MEM1 and pairwise disjoint controls/output/frame make the
+ * ten original cursor publications unobservable inside this callback-free
+ * block. Aliases, mirrors, journal callbacks and reservations retain the
+ * original translation. No guest cycle, final register or packet is omitted.
+ */
+#include "native_gd.h"
+#include "gather_pipe.h"
+#include <stdio.h>
+#include <stdint.h>
+
+static unsigned long long s_runs, s_declined;
+
+static int gd_packet(CPUState* cpu) {
+#if defined(BW_GUEST_MEM1)
+    const s64 cycles = 64;
+    if (cpu->exception != 0u || g_ppc_guest_aliases_overlap_mem1 ||
+        g_mem_write_journal != NULL || cpu->reserve_valid ||
+        cpu->cycle_budget <= 0 || cpu->downcount > 0 ||
+        cpu->downcount <= -cpu->cycle_budget ||
+        cpu->downcount < INT64_MIN + cycles ||
+        (cpu->cycle_deadline_budget > 0 &&
+         (cpu->cycle_deadline_budget < cycles ||
+          cpu->downcount < cycles - cpu->cycle_deadline_budget)))
+        return 0;
+
+    const u32 sda = cpu->gpr[13] - 25656u;
+    const u32 frame = cpu->gpr[1] + 8u;
+    if (!BW_RAM_FAST(cpu, sda, 4u) || !BW_RAM_FAST(cpu, frame, 16u))
+        return 0;
+    u8* const ram = BW_RAM_BYTES;
+    const u32 object = read_be32(ram + (sda - GC_RAM_BASE));
+    if (!BW_RAM_FAST(cpu, object, 16u)) return 0;
+    const u32 cursor = read_be32(ram + (object - GC_RAM_BASE) + 8u);
+    if (!BW_RAM_FAST(cpu, cursor, 10u)) return 0;
+
+    const u32 starts[4] = {sda, frame, object, cursor};
+    const u32 sizes[4] = {4u, 16u, 16u, 10u};
+    for (unsigned i = 0; i < 4; ++i)
+        for (unsigned j = i + 1; j < 4; ++j)
+            if (starts[i] < starts[j] + sizes[j] && starts[j] < starts[i] + sizes[i])
+                return 0;
+
+    const u32 color0 = cpu->gpr[31], color1 = cpu->gpr[30];
+    u8* const out = ram + (cursor - GC_RAM_BASE);
+    out[0] = 0x61u;
+    write_be32(out + 1u, color0);
+    out[5] = 0x61u;
+    write_be32(out + 6u, color1);
+    write_be32(ram + (object - GC_RAM_BASE) + 8u, cursor + 10u);
+
+    cpu->gpr[0] = read_be32(ram + (frame - GC_RAM_BASE) + 12u);
+    cpu->gpr[1] += 16u;
+    cpu->gpr[3] = cursor + 9u;
+    cpu->gpr[4] = object;
+    cpu->gpr[5] = (color1 >> 8u) & 255u;
+    cpu->gpr[6] = 0x61u;
+    cpu->gpr[30] = read_be32(ram + (frame - GC_RAM_BASE));
+    cpu->gpr[31] = read_be32(ram + (frame - GC_RAM_BASE) + 4u);
+    cpu->lr = cpu->gpr[0];
+    cpu->pc = cpu->lr & ~3u;
+    cpu->downcount -= cycles;
+    cpu->cycle_observation_suffix = 2u;
+    return 1;
+#else
+    /* Only the fixed MEM1 ownership policy has been qualified. */
+    (void)cpu;
+    return 0;
+#endif
+}
+
+int bluewake_native_gd(CPUState* cpu, u32 address) {
+    if (cpu == NULL || address != BLUEWAKE_GD_TEV_KCOLOR_RESUME) return 0;
+    const int done = gd_packet(cpu);
+    if (done) ++s_runs;
+    else ++s_declined;
+    return done;
+}
+
+void bluewake_native_gd_report(void) {
+    fprintf(stderr, "[native-gd] tev-kcolor=%llu/%llu (native/declined)\n", s_runs, s_declined);
+}
