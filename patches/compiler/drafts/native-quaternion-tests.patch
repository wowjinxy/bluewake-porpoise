+# math hooks to model the required certifier stage before downstream transforms.
+BODY=candidate.HOOK.sub('',CHUNK.read_text())
+DIGEST='385f769797cc36b8ef7de0bca33c828a57de95ee5b26216e637b15fb75a6752b'
+class Preparation(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory();self.root=pathlib.Path(self.tmp.name)
+        self.file=self.root/CHUNK.name;self.file.write_bytes(BODY.encode())
+        self.fragments=candidate.FRAGMENTS;self.entries=candidate.ENTRIES
+        candidate.FRAGMENTS={'quaternion':(0x802FD6E0,0x80301150,0x80301218,DIGEST)}
+        candidate.ENTRIES={0x80301150:('quaternion',)}
