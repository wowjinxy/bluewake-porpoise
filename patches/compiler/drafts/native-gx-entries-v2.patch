+        text = re.sub(r"( +)if \(ctx->downcount <= -\(s64\)DOLRECOMP_C_LOOP_CYCLE_BUDGET\) \{\n"
+                      r" +ctx->pc = 0x[0-9A-F]{8}u;\n +return;\n +\}\n",
