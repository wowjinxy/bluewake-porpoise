+        def leave(m):
+            ret, target = int(m.group(1), 16), int(m.group(2), 16)
+            return self.call(native, chunk, target, ret, boundary=True)
+        text = re.sub(r"            ctx->lr = 0x([0-9A-F]{8})u;\n            ctx->pc = 0x([0-9A-F]{8})u;\n"
+                      r"            return;\n", leave, text)
