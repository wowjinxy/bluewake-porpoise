+    DWORD old;
+    if (!p || !VirtualProtect(p, GC_MAIN_RAM_SIZE, PAGE_READONLY, &old) ||
+        !VirtualProtect(p + AREA - GC_RAM_BASE, N, PAGE_READWRITE, &old)) abort();
+    return p;
