+"""Current real certification path, including every extracted remainder loop."""
+import contextlib
+import os
+import importlib.util
+import io
+import json
+from pathlib import Path
+import re
+import sys
+import tempfile
+import unittest
+
+HERE=Path(__file__).resolve().parent
+ROOT=HERE.parent
+sys.path.insert(0,str(ROOT/'scripts/windows'))
+spec=importlib.util.spec_from_file_location('candidate_fmod',ROOT/'scripts/windows/native_game_math.py')
+candidate=importlib.util.module_from_spec(spec);spec.loader.exec_module(candidate)
+CHUNK=Path(os.environ['BLUEWAKE_FMOD_ORACLE_CHUNKS'])/'chunk_0203_text1_8032D6E0.c'
+LOOPS=(0x8032ECD8,0x8032ECF8,0x8032ED34,0x8032ED54,0x8032EEAC)
+RANGES={'finite_fmod':(0x8032D6E0,0x8032EC1C,0x8032EF58)}
+RANGES.update({f'fmod_loop_{p:08X}':(0x8032D6E0,f'loop_{p:08X}',None) for p in LOOPS})
+DIGEST={'finite_fmod': 'c8c4c71b68872c00423403d85e09fa06f3c8c06dae557831d264b3beab4ba4b2', 'fmod_loop_8032ECD8': '106a0e8fca84464ce1b0ce60ed220c1a03fc907669af33903247b06ec525cf9c', 'fmod_loop_8032ECF8': '1c9bf4d5af402ba0c5c678abafbae5ac18c94e4e14dd92babf0a9b04bb9796d3', 'fmod_loop_8032ED34': '1b47f64c9ee5115bcc31ec185e3124b10e4a49e1b215e67e11f7d1ab684af556', 'fmod_loop_8032ED54': 'd22235c9d2671073f3089e2ce4defcfef2257eff4eeea7b6c3d90293ff52fd61', 'fmod_loop_8032EEAC': '1344be94b1dbf72b76eb3494a8a0d6cc8e0fdf28cdf165185d75b4d48a44e0f0'}
+
+class Certification(unittest.TestCase):
+ def setUp(self):
+  self.temp=tempfile.TemporaryDirectory();self.root=Path(self.temp.name)
+  self.path=self.root/CHUNK.name;self.original=candidate.HOOK.sub('',CHUNK.read_text())
+  self.path.write_text(self.original)
+  self.fragments,self.entries=candidate.FRAGMENTS,candidate.ENTRIES
+  candidate.FRAGMENTS={name:(*row,DIGEST[name]) for name,row in RANGES.items()}
+  candidate.ENTRIES={0x8032EC1C:tuple(RANGES)}
+ def tearDown(self):
+  candidate.FRAGMENTS,candidate.ENTRIES=self.fragments,self.entries
+  self.temp.cleanup()
+ def certified(self,watched=(),extra=()):
+  with contextlib.redirect_stdout(io.StringIO()):return candidate.certify([self.path,*extra],set(watched))
+ def test_actual_canonical_fragments_and_idempotent_hook(self):
+  self.assertEqual(self.certified(),{0x8032EC1C})
+  body,count=candidate.transform(self.original,0x8032D6E0,{0x8032EC1C})
+  self.assertEqual(count,1)
+  self.assertEqual(candidate.transform(body,0x8032D6E0,{0x8032EC1C}),(body,0))
+ def test_changed_main_and_each_loop_c_declines(self):
+  for name,(_,start,end) in RANGES.items():
+   anchor=f'label_{start:08X}:\n' if isinstance(start,int) else f'static void {start}(CPUState* ctx) {{\n'
+   changed=self.original.replace(anchor,anchor+'    ctx->cr=0;\n',1)
+   self.assertNotEqual(changed,self.original)
+   self.path.write_text(changed)
+   self.assertEqual(self.certified(),set(),name)
+   self.path.write_text(self.original)
+ def test_changed_variant_leaves_every_base_untouched(self):
+  other=self.root/('mod_'+CHUNK.name)
+  other.write_text(self.original.replace('label_8032EC1C:\n','label_8032EC1C:\n    ctx->cr=0;\n',1))
+  self.assertEqual(self.certified(extra=[other]),set())
+  self.assertEqual(self.path.read_text(),self.original)
+ def test_every_observed_main_loop_pc_and_mirror_declines(self):
+  pcs=set()
+  for _,start,end in RANGES.values():
+   fragment=candidate.fragment(self.original,0x8032D6E0,start,end)
+   pcs.update(int(p,16) for p in re.findall(r'// ([8C][0-9A-F]{7}):',fragment))
+  self.assertGreater(len(pcs),190)
+  for pc in pcs:
+   for p in (pc,pc|0x40000000):
+    self.assertEqual(self.certified((p,p|0x40000000,p&~0x40000000)),set(),hex(p))
+ def test_lost_certificate_removes_existing_hook(self):
+  body,_=candidate.transform(self.original,0x8032D6E0,{0x8032EC1C})
+  restored,count=candidate.transform(body,0x8032D6E0,set())
+  self.assertEqual(count,0);self.assertNotIn('bluewake_native_game_math_try(ctx, 0x8032EC1Cu)',restored)
+  self.assertEqual(candidate.fragment(restored,0x8032D6E0,0x8032EC1C,0x8032EF58),candidate.fragment(self.original,0x8032D6E0,0x8032EC1C,0x8032EF58))
+ def test_default_not_enabled(self):
+  self.assertNotIn(0x8032EC1C,self.entries)
+  for name in RANGES:self.assertNotIn(name,self.fragments)
+
+class OptionReset(unittest.TestCase):
+ def test_removed_option_clears_previous_failed_preparation(self):
+  spec=importlib.util.spec_from_file_location('fresh_fmod',ROOT/'scripts/windows/native_game_math.py')
+  fresh=importlib.util.module_from_spec(spec);spec.loader.exec_module(fresh)
+  with tempfile.TemporaryDirectory() as temp:
+   root=Path(temp);header=root/'generated.h';header.write_text('/* authored */\n')
+   with contextlib.redirect_stdout(io.StringIO()):
+    with self.assertRaises(ValueError):fresh.prepare(root,False,False,False,False,True)
+    self.assertIn(0x8032EC1C,fresh.ENTRIES)
+    with self.assertRaises(ValueError):fresh.prepare(root)
+   self.assertNotIn(0x8032EC1C,fresh.ENTRIES)
+   for name in RANGES:self.assertNotIn(name,fresh.FRAGMENTS)
+   self.assertEqual(header.read_text(),'/* authored */\n')
+
+if __name__=='__main__':unittest.main()
