+cmake_minimum_required(VERSION 3.24)
+project(bluewake_game_math_budget_oracle C)
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+set(BLUEWAKE_ROOT "" CACHE PATH "BlueWake checkout after applying inactive patches")
+set(BLUEWAKE_ORIGINAL_MODULE "" CACHE FILEPATH "Personal unchanged GZLE01 module used as a function oracle")
+option(BLUEWAKE_ORACLE_ASAN "Instrument this fixture and all linked CPU sources" OFF)
+if(NOT BLUEWAKE_ROOT OR NOT BLUEWAKE_ORIGINAL_MODULE)
+  message(FATAL_ERROR "Explicit checkout and personal original-module paths required")
+endif()
+set(sdk "${BLUEWAKE_ROOT}/ref/recompcore")
+add_executable(game_math_budget
+  "${BLUEWAKE_ROOT}/tests/native_game_math_budget_test.c"
+  "${BLUEWAKE_ROOT}/cmake/composite/native_game_math.c"
+  "${sdk}/GXRuntime/src/core/cpu.c"
+  "${sdk}/GXRuntime/src/core/cpu_exception.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter_float.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter_integer.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter_table.c")
+target_include_directories(game_math_budget PRIVATE
+  "${BLUEWAKE_ROOT}/cmake/composite" "${sdk}/GXRuntime/include"
+  "${sdk}/Source/Core/Core/PowerPC/StaticRecomp")
+target_compile_definitions(game_math_budget PRIVATE BLUEWAKE_NATIVE_GAME_ATAN=1 BLUEWAKE_NATIVE_QUATERNION=1 BLUEWAKE_NATIVE_BG_MINMAX=1)
+if(CMAKE_C_COMPILER_ID MATCHES "Clang|GNU")
+  target_compile_options(game_math_budget PRIVATE -O3 -UNDEBUG -ffp-contract=off)
+  if(WIN32 AND CMAKE_C_COMPILER_ID MATCHES "Clang")
+    target_compile_options(game_math_budget PRIVATE -fms-compatibility-version=19.44 -fms-runtime-lib=dll -Wno-dll-attribute-on-redeclaration)
+    target_link_options(game_math_budget PRIVATE -fms-runtime-lib=dll)
+  endif()
+  if(BLUEWAKE_ORACLE_ASAN)
+    target_compile_options(game_math_budget PRIVATE -fsanitize=address -fno-omit-frame-pointer)
+    target_link_options(game_math_budget PRIVATE -fsanitize=address)
+    if(WIN32)
+      target_compile_options(game_math_budget PRIVATE -shared-libasan)
+      target_link_options(game_math_budget PRIVATE -shared-libasan)
+    endif()
+  endif()
+endif()
+enable_testing()
+add_test(NAME native_game_math_budget COMMAND game_math_budget "${BLUEWAKE_ORIGINAL_MODULE}")
+set_tests_properties(native_game_math_budget PROPERTIES TIMEOUT 300 ENVIRONMENT "ASAN_OPTIONS=detect_leaks=0:halt_on_error=1")
