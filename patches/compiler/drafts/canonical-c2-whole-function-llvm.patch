+    invokeResult = builder_.CreateCall(translated,
+        {ctx_, target, builder_.getInt32(continuation)});
+    Value *valid = builder_.CreateOr(
+        builder_.CreateICmpEQ(invokeResult, builder_.getInt32(1)),
+        builder_.CreateICmpEQ(invokeResult, builder_.getInt32(2)));
