+    if (row->precise_pc_write)
+      writePC();
+    Value *deadline = loadOffset(i64, offsetof(CPUState, cycle_deadline_budget));
+    Value *downcount = loadOffset(i64, offsetof(CPUState, downcount));
+    Function *add = Intrinsic::getDeclaration(&module_, Intrinsic::sadd_with_overflow,
+                                               {i64});
+    Value *sum = builder_.CreateCall(add, {deadline, downcount});
+    Value *remaining = builder_.CreateExtractValue(sum, 0);
+    Value *overflow = builder_.CreateExtractValue(sum, 1);
+    Value *positive = builder_.CreateICmpSGT(deadline, builder_.getInt64(0));
+    BasicBlock *supported = BasicBlock::Create(context_, "c2_precharge_supported", function_);
+    BasicBlock *unsupported = BasicBlock::Create(context_, "c2_precharge_overflow", function_);
+    builder_.CreateCondBr(builder_.CreateAnd(positive, overflow), unsupported,
+                          supported);
+    builder_.SetInsertPoint(unsupported);
+    // Signed-overflow states have no defined original C semantics. Decline
+    // before charging or executing this leader, never execute wrapped timing.
+    canonicalPublishState();
+    returnFromBody();
+    builder_.SetInsertPoint(supported);
+    paid = builder_.CreateOr(builder_.CreateNot(positive),
+        builder_.CreateAnd(builder_.CreateICmpSGE(remaining, builder_.getInt64(0)),
+                           builder_.CreateICmpUGE(remaining,
+                               builder_.getInt64(row->leader_cycles))));
+    builder_.CreateStore(paid, canonical_prepaid_);
+    emitBudgetGuard(pc);
+    Value *amount = builder_.CreateSelect(paid, builder_.getInt64(row->leader_cycles),
+                                         builder_.getInt64(row->first_precise_cycles));
+    builder_.CreateStore(builder_.CreateSub(downcount, amount),
+                         bytePtr(offsetof(CPUState, downcount)));
