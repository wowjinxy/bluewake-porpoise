+  BasicBlock *post = BasicBlock::Create(context_, "c2_paid_post_operation", function_);
+  BasicBlock *done = BasicBlock::Create(context_, "c2_post_operation_done", function_);
+  builder_.CreateCondBr(paid, post, done);
