+void FunctionEmitter::canonicalAfterInstruction(u32 pc) {
+  const DolLLVMCanonicalScheduleRow *row = nullptr;
+  for (u32 i = 0; i < canonical_schedule_count_; ++i)
+    if (canonical_schedule_[i].pc == pc) {
