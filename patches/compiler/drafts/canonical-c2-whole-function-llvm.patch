+      "bw_c2_direct_call_ready",
+      FunctionType::get(Type::getInt1Ty(context_), {pointer, i32}, false));
+  auto translated = module_.getOrInsertFunction(
+      "bw_c2_invoke_translated",
+      FunctionType::get(i32, {pointer, i32, i32}, false));
+  auto retainedSite = module_.getOrInsertFunction(
+      "bw_c2_invoke_retained_site",
+      FunctionType::get(Type::getInt1Ty(context_), {pointer, i32}, false));
+  BasicBlock *invoke = kind == DOLLLVM_CANONICAL_CALL_DIRECT_READY
+      ? BasicBlock::Create(context_, "canonical_call_invoke", function_) : nullptr;
+  BasicBlock *checkPC = BasicBlock::Create(context_, "canonical_call_check_pc", function_);
+  BasicBlock *checkReady = kind == DOLLLVM_CANONICAL_CALL_DIRECT_READY
+      ? BasicBlock::Create(context_, "canonical_call_check_ready", function_) : nullptr;
+  BasicBlock *matched = kind == DOLLLVM_CANONICAL_CALL_DIRECT_READY
+      ? BasicBlock::Create(context_, "canonical_call_matched", function_) : nullptr;
+  BasicBlock *resume = BasicBlock::Create(context_, "canonical_call_resume", function_);
+  BasicBlock *done = BasicBlock::Create(context_, "canonical_call_exit", function_);
+  if (kind == DOLLLVM_CANONICAL_CALL_RETAINED_SITE) {
+    /* Original same-chunk / postprocessed call body owns its observations.
+     * It is entered after this call instruction's exact charge. */
