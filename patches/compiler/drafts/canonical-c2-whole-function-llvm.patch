+    Value *invalid = builder_.CreateICmpEQ(budget,
+                                          builder_.getInt64(u64(1) << 63));
+    Value *exhausted = builder_.CreateOr(invalid,
+        builder_.CreateICmpSLE(downcount, builder_.CreateNeg(budget)));
+    BasicBlock *run = BasicBlock::Create(context_, "c2_budget_run", function_);
+    BasicBlock *exit = BasicBlock::Create(context_, "c2_budget_exit", function_);
+    builder_.CreateCondBr(exhausted, exit, run);
+    builder_.SetInsertPoint(exit);
+    canonicalPublishState();
+    storeContext(DOLIR_STATE_PC, builder_.getInt32(pc));
+    returnFromBody();
+    builder_.SetInsertPoint(run);
+    return;
+  }
   Type *i32 = Type::getInt32Ty(context_);
   Type *i64 = Type::getInt64Ty(context_);
   Type *pointer = PointerType::getUnqual(context_);
