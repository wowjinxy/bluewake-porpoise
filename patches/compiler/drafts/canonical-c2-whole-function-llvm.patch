+  Value *matches = builder_.CreateICmpEQ(returnedPC, builder_.getInt32(continuation));
+  if (!local || index >= blocks_.size())
+    matches = builder_.getFalse();
+  builder_.CreateCondBr(matches,
+                        kind == DOLLLVM_CANONICAL_CALL_RETAINED_SITE ? resume : matched,
+                        done);
+  if (matched) {
+    builder_.SetInsertPoint(matched);
+    /* Result 2 proves the original same-chunk central return gate fired after
+     * its original checks. Adding a readiness query here changes semantics. */
+    builder_.CreateCondBr(builder_.CreateICmpEQ(invokeResult, builder_.getInt32(2)),
+                          resume, checkReady);
+    builder_.SetInsertPoint(checkReady);
+    builder_.CreateCondBr(builder_.CreateCall(ready, {ctx_, builder_.getInt32(continuation)}),
+                          resume, done);
+  }
+  builder_.SetInsertPoint(done);
+  returnFromBody();
+  builder_.SetInsertPoint(resume);
