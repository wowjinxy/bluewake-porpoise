+      builder_.CreateBr(after);
+      builder_.SetInsertPoint(after);
+    }
+    BasicBlock *precise = BasicBlock::Create(context_, "c2_precise_charge", function_);
+    BasicBlock *ready = BasicBlock::Create(context_, "c2_instruction_ready", function_);
+    builder_.CreateCondBr(paid, ready, precise);
+    builder_.SetInsertPoint(precise);
+    emitBudgetGuard(pc);
+    Value *downcount = loadOffset(i64, offsetof(CPUState, downcount));
+    builder_.CreateStore(builder_.CreateSub(downcount, builder_.getInt64(row->precise_cycles)),
+                         bytePtr(offsetof(CPUState, downcount)));
