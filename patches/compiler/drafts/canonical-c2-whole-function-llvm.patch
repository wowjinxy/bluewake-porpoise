+// PC/downcount/suffix are scheduler-owned memory, not promoted guest registers.
+// In particular, publishing a callback frontier must not replace the original
+// fast copy's deliberately stale PC with the current decoded instruction PC.
+void FunctionEmitter::canonicalPublishState() {
+  for (u32 slot = 0; slot < DOLIR_STATE_COUNT; ++slot) {
+    if (!dirty_[slot] || slot == DOLIR_STATE_PC ||
+        slot == DOLIR_STATE_DOWNCOUNT || slot == DOLIR_STATE_FPSCR)
+      continue;
+    const auto stateSlot = static_cast<DolIRStateSlot>(slot);
+    if (!slotInMemory(stateSlot))
+      storeContext(stateSlot,
+                   builder_.CreateLoad(type(dolir_state_type(stateSlot)),
+                                       state_[slot]));
+  }
+  materializeFPRF();
+  if (dirty_[DOLIR_STATE_FPSCR])
+    storeContext(DOLIR_STATE_FPSCR, stateValue(DOLIR_STATE_FPSCR));
+}
+
+void FunctionEmitter::canonicalReloadStateAfterObserver() {
+  // reloadUsedState already invalidates representations/known values. These
+  // entry-control proofs must also die: an ordinary callback may change them.
+  stable_gqr_.fill(false);
+  stable_hid2_ = false;
+  stable_ni_ = false;
+  entry_gqr_.fill(nullptr);
+  entry_gqr_load_type_.fill(nullptr);
+  entry_gqr_store_type_.fill(nullptr);
+  entry_gqr_load_scale_.fill(nullptr);
+  entry_gqr_store_scale_.fill(nullptr);
+  entry_psq_direct_enabled_ = nullptr;
+  entry_psq_indexed_enabled_ = nullptr;
+  entry_ni_enabled_ = nullptr;
+  known_state_.fill(nullptr);
+  resetFPRepresentations();
+  fp_available_checked_ = false;
+  pending_fprf_ = nullptr;
