+bool FunctionEmitter::validateCanonicalSchedule(raw_ostream &diagnostics) {
+  if (!canonical_c2_)
+    return true;
+  if (!canonical_schedule_ ||
+      canonical_schedule_count_ != source_.block_count) {
+    diagnostics << "dolllvm: canonical C2 needs one exact schedule row per PPC instruction\n";
+    return false;
+  }
+  for (u32 i = 0; i < source_.block_count; ++i) {
+    const auto &row = canonical_schedule_[i];
+    const auto &block = source_.blocks[i];
+    if (row.pc != block.guest_address || row.raw != block.raw ||
+        !row.precise_cycles ||
+        (row.leader_cycles &&
+         (row.first_precise_cycles != row.precise_cycles ||
+          row.first_precise_cycles > row.leader_cycles)) ||
+        (!row.leader_cycles && row.first_precise_cycles) ||
+        (!row.suffix_write && row.suffix_value) ||
+        (row.fast_post_pc_write && !row.post_refund)) {
+      diagnostics << "dolllvm: invalid canonical C2 schedule row " << i << "\n";
+      return false;
+    }
+  }
+  return true;
+}
