+cmake_minimum_required(VERSION 3.24)
+project(bluewake_plane_oracle C)
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_C_STANDARD_REQUIRED ON)
+set(BLUEWAKE_ROOT "" CACHE PATH "Checkout after applying inactive patches")
+set(BLUEWAKE_ORIGINAL_MODULE "" CACHE FILEPATH "Personal unchanged GZLE01 function oracle")
+option(BLUEWAKE_ORACLE_ASAN "Instrument fixture and CPU/native sources" OFF)
+if(NOT BLUEWAKE_ROOT OR NOT BLUEWAKE_ORIGINAL_MODULE)
+  message(FATAL_ERROR "Explicit checkout and personal original module required")
+endif()
+set(sdk "${BLUEWAKE_ROOT}/ref/recompcore")
+set(common_sources
+  "${BLUEWAKE_ROOT}/cmake/composite/native_game_math.c"
+  "${BLUEWAKE_ROOT}/cmake/composite/native_vec.c"
+  "${sdk}/GXRuntime/src/core/cpu.c"
+  "${sdk}/GXRuntime/src/core/cpu_exception.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter_float.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter_integer.c"
+  "${sdk}/GXRuntime/src/core/cpu_interpreter_table.c")
+enable_testing()
+foreach(name IN ITEMS plane plane_boundaries)
+  add_executable(${name} "${BLUEWAKE_ROOT}/tests/native_${name}_test.c" ${common_sources})
+  target_include_directories(${name} PRIVATE "${BLUEWAKE_ROOT}/cmake/composite"
+    "${sdk}/GXRuntime/include" "${sdk}/Source/Core/Core/PowerPC/StaticRecomp")
+  target_compile_definitions(${name} PRIVATE BLUEWAKE_NATIVE_PLANE=1)
+  target_compile_options(${name} PRIVATE -O3 -UNDEBUG -ffp-contract=off)
+  if(WIN32 AND CMAKE_C_COMPILER_ID MATCHES "Clang")
+    target_compile_options(${name} PRIVATE -fms-compatibility-version=19.44 -fms-runtime-lib=dll -Wno-dll-attribute-on-redeclaration)
+    target_link_options(${name} PRIVATE -fms-runtime-lib=dll)
+  endif()
+  if(BLUEWAKE_ORACLE_ASAN)
+    target_compile_options(${name} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
+    target_link_options(${name} PRIVATE -fsanitize=address)
+    if(WIN32)
+      target_compile_options(${name} PRIVATE -shared-libasan)
+      target_link_options(${name} PRIVATE -shared-libasan)
+    endif()
+  endif()
+  add_test(NAME native_${name} COMMAND ${name} "${BLUEWAKE_ORIGINAL_MODULE}")
+  set_tests_properties(native_${name} PROPERTIES TIMEOUT 300 ENVIRONMENT "ASAN_OPTIONS=detect_leaks=0:halt_on_error=1")
+endforeach()
