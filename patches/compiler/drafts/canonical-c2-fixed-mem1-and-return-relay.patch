+// SOURCE DRAFT ONLY. Included in memory.cpp inside namespace dolllvm.
+// This mode is explicitly limited to the C2 ABI-5 fixed CPU + fixed MEM1 bank.
+// No guessed CPU.ram ownership or normalized alias address is used here.
+Value *FunctionEmitter::canonicalFixedMem1Guard(Value *address, u32 width,
+                                                bool writing, Value **offset) {
+  if (width != 1u && width != 2u && width != 4u && width != 8u)
+    report_fatal_error("canonical fixed MEM1 access has unsupported width");
+  Type *i8 = Type::getInt8Ty(context_);
+  Type *pointer = PointerType::getUnqual(context_);
+  auto *overlap = cast<GlobalVariable>(module_.getOrInsertGlobal(
+      "g_ppc_guest_aliases_overlap_mem1", i8));
+  LoadInst *currentOverlap = builder_.CreateLoad(i8, overlap, "c2.alias_overlap");
+  currentOverlap->setVolatile(true); // an actual fresh guard at every operation
+  *offset = builder_.CreateSub(address, builder_.getInt32(0x80000000u));
+  Value *eligible = builder_.CreateAnd(
+      builder_.CreateICmpEQ(currentOverlap, builder_.getInt8(0)),
+      builder_.CreateAnd(
+          builder_.CreateICmpEQ(builder_.CreateAnd(address, builder_.getInt32(0x40000000u)),
+                               builder_.getInt32(0)),
+          builder_.CreateICmpULE(*offset, builder_.getInt32(canonical_mem1_size_ - width))));
+  if (writing) {
+    auto *journal = cast<GlobalVariable>(module_.getOrInsertGlobal(
+        "g_mem_write_journal", pointer));
+    LoadInst *currentJournal = builder_.CreateLoad(pointer, journal, "c2.write_journal");
+    currentJournal->setVolatile(true);
+    eligible = builder_.CreateAnd(eligible, builder_.CreateIsNull(currentJournal));
+  }
+  return eligible;
+}
+
+Value *FunctionEmitter::canonicalFixedMem1Pointer(Value *offset) {
+  ArrayType *bankType = ArrayType::get(Type::getInt8Ty(context_), canonical_mem1_size_);
+  GlobalVariable *bank = module_.getNamedGlobal(canonical_mem1_symbol_);
+  if (bank && bank->getValueType() != bankType)
+    report_fatal_error("canonical fixed MEM1 global has conflicting extent/type");
+  if (!bank)
+    bank = new GlobalVariable(module_, bankType, false, GlobalValue::ExternalLinkage,
+                              nullptr, canonical_mem1_symbol_);
+  // This inbounds GEP is constructed only in the guarded fast block.
+  return builder_.CreateInBoundsGEP(Type::getInt8Ty(context_), bank, offset);
+}
+
+void FunctionEmitter::canonicalClearFixedReservation(Value *address) {
+  // Only reservation fields need publication. All unrelated guest registers
+  // remain local; a callback cannot run on this already-admitted RAM arm.
+  if (dirty_[DOLIR_STATE_RESERVE_ADDR])
+    syncState(DOLIR_STATE_RESERVE_ADDR);
+  if (dirty_[DOLIR_STATE_RESERVE_VALID])
+    syncState(DOLIR_STATE_RESERVE_VALID);
+  Type *i8 = Type::getInt8Ty(context_);
+  Value *valid = loadOffset(i8, offsetof(CPUState, reserve_valid));
+  Value *reserved = loadOffset(Type::getInt32Ty(context_), offsetof(CPUState, reserve_addr));
+  // Exactly clear_matching_reservation: clear mirror bit, compare 32-byte line.
+  Value *difference = builder_.CreateAnd(builder_.CreateXor(reserved, address),
+                                         builder_.getInt32(~(0x40000000u | 31u)));
+  Value *matches = builder_.CreateAnd(builder_.CreateICmpNE(valid, builder_.getInt8(0)),
+                                      builder_.CreateICmpEQ(difference, builder_.getInt32(0)));
+  BasicBlock *clear = BasicBlock::Create(context_, "c2.reservation_clear", function_);
+  BasicBlock *done = BasicBlock::Create(context_, "c2.reservation_done", function_);
+  builder_.CreateCondBr(matches, clear, done);
+  builder_.SetInsertPoint(clear);
+  builder_.CreateStore(builder_.getInt8(0), bytePtr(offsetof(CPUState, reserve_valid)));
+  if (used_[DOLIR_STATE_RESERVE_VALID])
+    reloadState(DOLIR_STATE_RESERVE_VALID);
+  builder_.CreateBr(done);
+  builder_.SetInsertPoint(done);
+}
+
+Value *FunctionEmitter::canonicalFixedMem1Load(Value *address, Type *resultType,
+                                               u32 width, bool sign) {
+  // A compile-time deferred FPRF cannot be discarded only while generating
+  // the slow arm. Materialize it to the local FPSCR state before branching.
+  materializeFPRF();
+  Value *offset = nullptr;
+  Value *eligible = canonicalFixedMem1Guard(address, width, false, &offset);
+  BasicBlock *fast = BasicBlock::Create(context_, "c2.load_mem1", function_);
+  BasicBlock *slow = BasicBlock::Create(context_, "c2.load_service", function_);
+  BasicBlock *join = BasicBlock::Create(context_, "c2.load_join", function_);
+  builder_.CreateCondBr(eligible, fast, slow);
+  builder_.SetInsertPoint(fast);
+  Type *i64 = Type::getInt64Ty(context_);
+  Value *direct = endianLoad(canonicalFixedMem1Pointer(offset), i64, width);
+  BasicBlock *fastEnd = builder_.GetInsertBlock();
+  builder_.CreateBr(join);
+  builder_.SetInsertPoint(slow);
+  Value *unusedYield = nullptr;
+  Value *fallback = externalRead(address, width, &unusedYield);
+  BasicBlock *slowEnd = builder_.GetInsertBlock();
+  builder_.CreateBr(join);
+  builder_.SetInsertPoint(join);
+  PHINode *value = builder_.CreatePHI(i64, 2, "c2.memory_value");
+  value->addIncoming(direct, fastEnd);
+  value->addIncoming(fallback, slowEnd);
+  // Slow-arm reloads conservatively invalidate compile-time facts for both
+  // arms; their state allocas/SSA PHIs still preserve the actual fast values.
+  if (sign && width * 8u < resultType->getIntegerBitWidth())
+    return builder_.CreateSExt(builder_.CreateTrunc(value, IntegerType::get(context_, width * 8u)),
+                                resultType);
+  return builder_.CreateZExtOrTrunc(value, resultType);
+}
+
+void FunctionEmitter::canonicalFixedMem1Store(Value *address, Value *value, u32 width) {
+  materializeFPRF();
+  Value *offset = nullptr;
+  Value *eligible = canonicalFixedMem1Guard(address, width, true, &offset);
+  BasicBlock *fast = BasicBlock::Create(context_, "c2.store_mem1", function_);
+  BasicBlock *slow = BasicBlock::Create(context_, "c2.store_service", function_);
+  BasicBlock *join = BasicBlock::Create(context_, "c2.store_join", function_);
+  builder_.CreateCondBr(eligible, fast, slow);
+  builder_.SetInsertPoint(fast);
+  canonicalClearFixedReservation(address);
+  endianStore(canonicalFixedMem1Pointer(offset), value, width);
+  builder_.CreateBr(join);
+  builder_.SetInsertPoint(slow);
+  externalWrite(address, value, width);
+  builder_.CreateBr(join);
+  builder_.SetInsertPoint(join);
+}
