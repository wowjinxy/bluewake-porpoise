+bool selectCanonicalInitialEntries(const DolIRFunction &source,
+                                   const DolLLVMOptions &options,
+                                   std::vector<bool> &selected) {
+  selected.assign(source.block_count, true);
+  if (!options.canonical_c2_filter_initial_entries)
+    return true;
+  selected.assign(source.block_count, false);
+  if (!options.canonical_c2 || !source.blocks || !options.entry_points ||
+      !options.entry_point_count || options.entry_point_count > source.block_count)
+    return false;
+  for (u32 requested = 0; requested < options.entry_point_count; requested++) {
+    const u32 pc = options.entry_points[requested];
+    if ((pc & 3u) || pc < source.guest_start || pc >= source.guest_end)
+      return false;
+    bool found = false;
+    for (u32 index = 0; index < source.block_count; index++) {
+      const DolIRBlock &block = source.blocks[index];
+      if (block.guest_address != pc)
+        continue;
+      if (selected[index] || block.terminator.kind == DOLIR_TERM_FALLBACK)
+        return false;
+      selected[index] = true;
+      found = true;
+      break;
+    }
+    if (!found)
+      return false;
+  }
+  return true;
+}
