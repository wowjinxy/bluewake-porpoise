+/* Authored instruction programs exercise the actual emitter and CPU runtime.
+ * No native/game inputs, guest state, or module is loaded. */
+#include "backend/emitter.h"
+#include "backend/option_sites.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static PPCInst op(PPCOpcode code,unsigned d,unsigned a,unsigned b,unsigned c) {
+    PPCInst i={0};i.op=code;i.rD=d;i.rA=a;i.rB=b;i.rC=c;i.rc=1;return i;
+}
+static void add(PPCInst* p,unsigned* n,PPCInst i){p[(*n)++]=i;}
+static void program(FILE* out,unsigned which) {
+    PPCInst p[40];unsigned n=0;const u32 base=0x80006000u+which*0x100u;
+    add(p,&n,op(PPC_OP_PS_NEG,1,0,1,0));
+    add(p,&n,op(PPC_OP_PS_ABS,2,0,2,0));
+    add(p,&n,op(PPC_OP_PS_NABS,3,0,3,0));
+    if(which==1 || which==2 || which==3) {
+        PPCInst mem=op(which==2?PPC_OP_STW:PPC_OP_LWZ,4,10,0,0);mem.rS=4;mem.simm=0;add(p,&n,mem);
+    }
+    if(which==4) {
+        PPCInst branch=op(PPC_OP_BC,0,0,0,0);branch.bo=12;branch.bi=2;branch.branch_target=base+20;add(p,&n,branch);
+        add(p,&n,op(PPC_OP_PS_ADD,2,1,3,0));
+    }
+    if(which==5) {
+        PPCInst load=op(PPC_OP_LFS,2,10,0,0);load.simm=0;add(p,&n,load);
+    }
+    if(which==6) add(p,&n,op(PPC_OP_FRSP,2,0,2,0));
+    if(which==7) add(p,&n,op(PPC_OP_PS_RES,2,0,2,0));
+    if(which==8) add(p,&n,op(PPC_OP_PS_MERGE00,2,2,3,0));
+    add(p,&n,op(PPC_OP_PS_MUL,4,1,0,2));
+    add(p,&n,op(PPC_OP_PS_MADD,5,4,3,2));
+    add(p,&n,op(PPC_OP_PS_MSUB,6,1,5,2));
+    add(p,&n,op(PPC_OP_PS_NMADD,7,4,3,2));
+    add(p,&n,op(PPC_OP_PS_NMSUB,8,1,5,2));
+    add(p,&n,op(PPC_OP_PS_MULS0,9,1,0,2));
+    add(p,&n,op(PPC_OP_PS_MULS1,11,1,0,2));
+    add(p,&n,op(PPC_OP_PS_MADDS0,12,4,3,2));
+    add(p,&n,op(PPC_OP_PS_MADDS1,13,4,3,2));
+    add(p,&n,op(PPC_OP_FMULS,14,1,0,2));
+    add(p,&n,op(PPC_OP_PS_MADD,15,14,13,2));
+    if(which==9) {
+        PPCInst load=op(PPC_OP_LWZ,20,10,0,0);add(p,&n,load);
+        PPCInst compare=op(PPC_OP_CMPLI,0,20,0,0);compare.crfD=0;compare.uimm=0;add(p,&n,compare);
+        PPCInst branch=op(PPC_OP_BC,0,0,0,0);branch.bo=12;branch.bi=2;branch.branch_target=base+(n-2)*4;add(p,&n,branch);
+        add(p,&n,op(PPC_OP_PS_MUL,16,1,0,2));
+    }
+    for(unsigned i=0;i<n;++i)p[i].address=base+4*i;
+    if(!emit_function(out,p,n,base))exit(2);
+    fprintf(out,"/* program %u instructions %u end %08X */\n",which,n,base+4*n);
+}
+int main(int argc,char** argv) {
+    if(argc!=3)return 2;
+    if(!option_sites_load(argv[2]))return 3;
+    option_sites_resolve_dol();
+    char path[1024];snprintf(path,sizeof path,"%s/generated.h",argv[1]);
+    FILE* h=fopen(path,"wb");if(!h)return 4;emit_header(h);emit_footer(h);fclose(h);
+    snprintf(path,sizeof path,"%s/generated.c",argv[1]);
+    FILE* c=fopen(path,"wb");if(!c)return 5;
+    fprintf(c,"#define DOLRECOMP_CPU_HEADER \"core/cpu.h\"\n#include \"generated.h\"\n#include \"inline_fp.h\"\n#include \"fixture_support.h\"\n");
+    for(unsigned i=0;i<13;++i)program(c,i);
+    fclose(c);puts("13 actual emitted instruction programs");return 0;
+}
