+/* Full actual emitted-code CPU/FP/exception comparison. All inputs are authored;
+ * callbacks model observable mutation, never native/game authority. */
+#include "core/cpu.h"
+#include <fenv.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <xmmintrin.h>
+unsigned dolrecomp_call_depth;
+unsigned char dolrecomp_option_flags[256];
+#define DECLARE(addr) void ref_##addr(CPUState*);void func_##addr(CPUState*);
+DECLARE(80006000) DECLARE(80006100) DECLARE(80006200) DECLARE(80006300)
+DECLARE(80006400) DECLARE(80006500) DECLARE(80006600) DECLARE(80006700)
+DECLARE(80006800) DECLARE(80006900) DECLARE(80006A00) DECLARE(80006B00) DECLARE(80006C00)
+typedef void(*Function)(CPUState*);
+static Function refs[]={ref_80006000,ref_80006100,ref_80006200,ref_80006300,ref_80006400,ref_80006500,ref_80006600,ref_80006700,ref_80006800,ref_80006900,ref_80006A00,ref_80006B00,ref_80006C00};
+static Function opts[]={func_80006000,func_80006100,func_80006200,func_80006300,func_80006400,func_80006500,func_80006600,func_80006700,func_80006800,func_80006900,func_80006A00,func_80006B00,func_80006C00};
+static const unsigned lengths[]={14,15,15,15,16,15,15,15,15,18,14,14,14};
+static const u64 patterns[]={
+ 0,0x8000000000000000ull,0x3FF0000000000000ull,0xBFF0000000000000ull,
+ 0x3FF0000002000001ull,0x400921FB54442D18ull,0x3FD5555555555555ull,
+ 0x7FF0000000000000ull,0xFFF0000000000000ull,0x7FF8000000000001ull,
+ 0x7FF0000000000001ull,0xFFF000000000007Full,1ull,0x8000000000000001ull,
+ 0x0010000000000000ull,0x36A0000000000000ull,0x3810000000000000ull,
+ 0x380FFFFFC0000000ull,0x47EFFFFFE0000000ull,0x7FEFFFFFFFFFFFFFull,
+ 0x3FEFFFFFF0000000ull,0x3FF0000010000000ull,0xC001FFFFE0000000ull,
+ 0x3E70000000000000ull,0x3FF0000000000001ull,0xBFF0000000000001ull,
+ 0x3FF0000020000000ull,0x3FF0000040000000ull,0x001FFFFFFFFFFFFFull,
+ 0x37E0000000000000ull,0xC7EFFFFFE0000000ull,0x46A0000000000000ull};
+static unsigned active_program,callback_mode,callbacks,hook_calls;
+static unsigned long long checks,cases,callback_cases,interrupted_cases;
+static u64 digest=1469598103934665603ull;
+static unsigned char memory[256],reference_memory[256];
+static f64 from_bits(u64 b){f64 d;memcpy(&d,&b,8);return d;}
+static void mutate(CPUState* cpu) {
+    ++callbacks;
+    cpu->fpr[1]=from_bits(0x3FF0000002000001ull);
+    cpu->ps1[1]=from_bits(0x4000000004000001ull);
+    cpu->fpr[2]=from_bits(0x4008000002000001ull);
+    cpu->ps1[2]=from_bits(0xBFE0000004000001ull);
