+    refs[which](&baseline);ref_calls=callbacks;ref_hooks=hook_calls;ref_mxcsr=_mm_getcsr()&0x3Fu;ref_flags=fetestexcept(FE_ALL_EXCEPT);
+    memcpy(reference_memory,memory,sizeof memory);
+    memset(memory,(int)(seed+which),sizeof memory);callbacks=hook_calls=0;
+    fesetround(rounds[rn]);_mm_setcsr((_mm_getcsr()&~0x807Fu)|flush[host]);feclearexcept(FE_ALL_EXCEPT);
+    opts[which](&candidate);
+    checks+=5;++cases;
+    if(memcmp(&baseline,&candidate,sizeof baseline)||memcmp(memory,reference_memory,sizeof memory)||ref_calls!=callbacks||ref_hooks!=hook_calls||ref_mxcsr!=(_mm_getcsr()&0x3Fu)||ref_flags!=fetestexcept(FE_ALL_EXCEPT)) {
+        fprintf(stderr,"PARITY seed=%u program=%u entry=%u rn=%u ni=%u host=%u option=%u budget=%u cpu=%d callback=%u/%u hook=%u/%u flags=%x/%x mxcsr=%x/%x pc=%08x/%08x fpscr=%08x/%08x\n",seed,which,entry,rn,ni,host,option,budget,memcmp(&baseline,&candidate,sizeof baseline),ref_calls,callbacks,ref_hooks,hook_calls,ref_flags,fetestexcept(FE_ALL_EXCEPT),ref_mxcsr,_mm_getcsr()&0x3Fu,baseline.pc,candidate.pc,baseline.fpscr,candidate.fpscr);
+        for(unsigned r=0;r<32;++r)if(memcmp(&baseline.fpr[r],&candidate.fpr[r],8)||memcmp(&baseline.ps1[r],&candidate.ps1[r],8))fprintf(stderr,"FPR%u %a/%a PS1 %a/%a\n",r,baseline.fpr[r],candidate.fpr[r],baseline.ps1[r],candidate.ps1[r]);
+        return 0;
+    }
+    if(callbacks||hook_calls)++callback_cases;
+    if(candidate.pc>=0x80006000u+which*0x100u&&candidate.pc<0x80006000u+which*0x100u+lengths[which]*4u)++interrupted_cases;
