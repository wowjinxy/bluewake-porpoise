+}
+int main(void) {
+    if(sizeof(CPUState)!=3552u){fprintf(stderr,"actual CPU ABI size=%zu\n",sizeof(CPUState));return 2;}
+    const unsigned budgets[]={1,7,256};
+    for(unsigned seed=0;seed<32;++seed)for(unsigned which=0;which<13;++which)
+    for(unsigned entry=0;entry<lengths[which];++entry)for(unsigned rn=0;rn<4;++rn)
+    for(unsigned ni=0;ni<2;++ni)for(unsigned host=0;host<4;++host)
