+static u64 read_external(CPUState* cpu,u32 ea,u8 size) {
+    (void)ea;(void)size;mutate(cpu);
+    if(active_program==5)return 0x3F800001u;
+    return callbacks<3 && active_program==9 ? 0u : 7u;
+}
+static void write_external(CPUState* cpu,u32 ea,u64 value,u8 size) {
+    (void)ea;(void)value;(void)size;mutate(cpu);
+}
+u32 dolrecomp_native_hook(CPUState* cpu,u32 id) {
+    ++hook_calls;mutate(cpu);
+    return id==2u && callback_mode==2 ? 0x80000000u : 0u;
+}
+static int compare_case(unsigned seed,unsigned which,unsigned entry,unsigned rn,unsigned ni,unsigned host,unsigned option,unsigned budget) {
+    CPUState initial;memset(&initial,0,sizeof initial);
+    initial.pc=0x80006000u+which*0x100u+entry*4u;initial.lr=0x81234564u;
+    initial.msr=PPC_MSR_FP|PPC_MSR_FE0|PPC_MSR_FE1;initial.hid2=PPC_HID2_PSE|PPC_HID2_LSQE;
