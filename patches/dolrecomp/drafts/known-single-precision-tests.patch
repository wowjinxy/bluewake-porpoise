+    initial.external_read=read_external;initial.external_write=write_external;
+    for(unsigned r=0;r<32;++r){initial.fpr[r]=from_bits(patterns[(seed+r*3u)%32u]);initial.ps1[r]=from_bits(patterns[(seed*7u+r*5u)%32u]);}
+    const int rounds[]={FE_TONEAREST,FE_TOWARDZERO,FE_UPWARD,FE_DOWNWARD};
+    const unsigned flush[]={0,0x40u,0x8000u,0x8040u};
+    CPUState baseline=initial,candidate=initial;
+    unsigned ref_calls=0,ref_hooks=0,ref_mxcsr=0;int ref_flags=0;
+    active_program=which;callback_mode=which==3?3u:seed%4u;dolrecomp_option_flags[0]=(unsigned char)option;
