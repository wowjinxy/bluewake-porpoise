+        fprintf(out, "#define DOLRECOMP_KNOWN_PS_MADDS0(cpu,d,a,c,b,k) ppc_ps_madds0(cpu,d,a,c,b)\n");
+        fprintf(out, "#define DOLRECOMP_KNOWN_PS_MADDS1(cpu,d,a,c,b,k) ppc_ps_madds1(cpu,d,a,c,b)\n\n");
+    }
 }
 
