+/* AceSpectre 83398f1: invocation-local facts preserve arbitrary PC entry. */
+static _Thread_local bool known_single_emit_active;
+static bool known_single_enabled(void) {
+    const char* value = getenv("DOLRECOMP_KNOWN_SINGLE");
+    return value && value[0] == '1' && value[1] == '\0';
+}
+
+static bool known_single_result(const PPCInst* inst) {
+    switch (inst->op) {
+    case PPC_OP_LFS: case PPC_OP_LFSU: case PPC_OP_LFSX: case PPC_OP_LFSUX:
+    case PPC_OP_PS_ADD: case PPC_OP_PS_SUB: case PPC_OP_PS_MUL: case PPC_OP_PS_DIV:
+    case PPC_OP_PS_RSQRTE: case PPC_OP_PS_MADD: case PPC_OP_PS_MSUB:
+    case PPC_OP_PS_NMADD: case PPC_OP_PS_NMSUB: case PPC_OP_PS_NEG: case PPC_OP_PS_ABS:
+    case PPC_OP_PS_NABS: case PPC_OP_PS_SUM0: case PPC_OP_PS_SUM1:
+    case PPC_OP_PS_MULS0: case PPC_OP_PS_MULS1: case PPC_OP_PS_MADDS0: case PPC_OP_PS_MADDS1:
+        return true;
+    default: return false;
+    }
+}
+
+static bool known_single_preserves(const PPCInst* inst) {
+    if (known_single_result(inst) && inst->op != PPC_OP_LFS && inst->op != PPC_OP_LFSU &&
+        inst->op != PPC_OP_LFSX && inst->op != PPC_OP_LFSUX) return true;
+    switch (inst->op) {
+    case PPC_OP_FMULS:
+    case PPC_OP_ADDI: case PPC_OP_ADDIS: case PPC_OP_ORI: case PPC_OP_ORIS:
+    case PPC_OP_XORI: case PPC_OP_XORIS: case PPC_OP_ANDI: case PPC_OP_ANDIS:
+    case PPC_OP_ADD: case PPC_OP_SUBF: case PPC_OP_OR: case PPC_OP_XOR: case PPC_OP_AND:
+    case PPC_OP_CMP: case PPC_OP_CMPL: case PPC_OP_CMPI: case PPC_OP_CMPLI:
+        return true;
+    default: return false;
+    }
+}
 
