@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Private authored GPU test seam. Not part of the public Aurora API.
+#pragma once
+#if !defined(AURORA_DIRECT_PRESENT_SURFACE_TEST) || AURORA_DIRECT_PRESENT_SURFACE_TEST != 1
+#error "This private seam requires AURORA_DIRECT_PRESENT_SURFACE_TEST=1"
+#endif
+
+#include "webgpu/gpu.hpp"
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace aurora::surface_probe {
+struct Capture {
+  bool ok = false;
+  bool direct_copy = false;
+  uint32_t acquire_count = 0;
+  uint32_t capture_count = 0;
+  uint32_t width = 0, height = 0;
+  wgpu::TextureFormat format = wgpu::TextureFormat::Undefined;
+  webgpu::Viewport viewport{};
+  std::string error;
+  std::vector<uint8_t> rgba;
+};
+
+// Exact explicit opt-in AND the already selected noninteractive mode.
+bool enabled() noexcept;
+bool allow_hidden_acquire() noexcept;
+bool suppress_present() noexcept;
+void note_present_call() noexcept;
+uint32_t present_calls() noexcept;
+bool copy_opt_in(bool production_value) noexcept;
+bool begin_capture(bool force_direct_copy);
+void note_acquire(wgpu::SurfaceGetCurrentTextureStatus status, bool acquired);
+void encode_capture(const wgpu::CommandEncoder& encoder, const wgpu::Texture& texture,
+                    bool direct_copy, const webgpu::Viewport& viewport);
+Capture finish_capture(); // Main thread, bounded map wait, no SDL input pump.
+
+// Defined in the private gpu.cpp projection to query its real adapter.
+// Adds CopySrc only; requires existing production CopyDst/Opaque selection.
+enum class ConfigureStatus { Ready, Unsupported, Failed };
+ConfigureStatus configure_surface_readback();
+} // namespace aurora::surface_probe
diff --git a/GXRuntime/graphics/aurora/lib/direct_present_probe.cpp b/GXRuntime/graphics/aurora/lib/direct_present_probe.cpp
new file mode 100644
--- /dev/null
+++ b/GXRuntime/graphics/aurora/lib/direct_present_probe.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Authored test-only capture of the actual acquired surface, after ImGui.
+#include "direct_present_probe.hpp"
+#include "gfx/common.hpp"
+#include "internal.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+namespace aurora::surface_probe {
+namespace {
+constexpr uint32_t MaxDimension = 4096;
+constexpr uint64_t MaxReadbackBytes = 64ull * 1024 * 1024;
+struct State {
+  Capture result;
+  bool force_direct = false;
+  wgpu::Buffer buffer;
+  uint32_t pitch = 0;
+  uint64_t bytes = 0;
+  std::atomic_bool map_done{false};
+  std::atomic_bool map_ok{false};
+};
+std::mutex state_mutex;
+std::shared_ptr<State> current;
+std::atomic_uint32_t observed_present_calls{0};
+
+std::shared_ptr<State> get_state() {
+  const std::lock_guard lock{state_mutex};
+  return current;
+}
+bool exact_one(const char* value) noexcept {
+  return value && value[0] == '1' && value[1] == '\0';
+}
+void fail(State& state, const char* message) {
+  if (state.result.error.empty()) state.result.error = message;
+}
+} // namespace
+
+bool enabled() noexcept {
+  return g_config.noninteractive && exact_one(std::getenv("DOL_AURORA_HIDDEN_SURFACE_PROBE"));
+}
+bool allow_hidden_acquire() noexcept { return enabled() && bool(get_state()); }
+bool suppress_present() noexcept { return enabled(); }
+void note_present_call() noexcept { observed_present_calls.fetch_add(1, std::memory_order_relaxed); }
+uint32_t present_calls() noexcept { return observed_present_calls.load(std::memory_order_relaxed); }
+bool copy_opt_in(bool production_value) noexcept {
+  if (enabled()) {
+    if (const auto state = get_state()) return state->force_direct;
+  }
+  return production_value;
+}
+bool begin_capture(bool force_direct_copy) {
+  if (!enabled()) return false;
+  gfx::gpu_synchronize();
+  const std::lock_guard lock{state_mutex};
+  if (current) return false; // Never overlap or silently replace a capture.
+  current = std::make_shared<State>();
+  current->force_direct = force_direct_copy;
+  return true;
+}
+void note_acquire(wgpu::SurfaceGetCurrentTextureStatus status, bool acquired) {
+  if (const auto state = get_state()) {
+    if (++state->result.acquire_count != 1) fail(*state, "More than one acquired frame");
+    if (!acquired || status != wgpu::SurfaceGetCurrentTextureStatus::SuccessOptimal)
+      fail(*state, "Actual hidden surface acquisition was not SuccessOptimal");
+  }
+}
+void encode_capture(const wgpu::CommandEncoder& encoder, const wgpu::Texture& texture,
+                    bool direct_copy, const webgpu::Viewport& viewport) {
+  const auto state = get_state();
+  if (!state) return;
+  if (++state->result.capture_count != 1) {
+    fail(*state, "More than one surface capture");
+    return;
+  }
+  auto& out = state->result;
+  out.direct_copy = direct_copy;
+  out.viewport = viewport;
+  out.width = texture.GetWidth();
+  out.height = texture.GetHeight();
+  out.format = texture.GetFormat();
+  if (!out.width || !out.height || out.width > MaxDimension || out.height > MaxDimension ||
+      texture.GetDepthOrArrayLayers() != 1 || texture.GetSampleCount() != 1 ||
+      texture.GetDimension() != wgpu::TextureDimension::e2D ||
+      (texture.GetUsage() & wgpu::TextureUsage::CopySrc) == wgpu::TextureUsage::None ||
+      (out.format != wgpu::TextureFormat::RGBA8Unorm && out.format != wgpu::TextureFormat::BGRA8Unorm)) {
+    fail(*state, "Actual surface properties cannot be read back by this bounded oracle");
+    return;
+  }
+  state->pitch = (out.width * 4u + 255u) & ~255u;
+  state->bytes = uint64_t(state->pitch) * out.height;
+  if (state->bytes > MaxReadbackBytes) {
+    fail(*state, "Readback byte limit");
+    return;
+  }
+  const wgpu::BufferDescriptor descriptor{
+      .label = "Private post-ImGui hidden surface readback",
+      .usage = wgpu::BufferUsage::CopyDst | wgpu::BufferUsage::MapRead,
+      .size = state->bytes,
+  };
+  state->buffer = webgpu::g_device.CreateBuffer(&descriptor);
+  if (!state->buffer) {
+    fail(*state, "Actual readback buffer creation failed");
+    return;
+  }
+  const wgpu::TexelCopyTextureInfo source{.texture = texture};
+  const wgpu::TexelCopyBufferInfo target{
+      .layout = {.offset = 0, .bytesPerRow = state->pitch, .rowsPerImage = out.height},
+      .buffer = state->buffer,
+  };
+  const wgpu::Extent3D extent{out.width, out.height, 1};
+  encoder.CopyTextureToBuffer(&source, &target, &extent);
+}
+Capture finish_capture() {
+  gfx::gpu_synchronize(); // Actual end-frame callback/Submit must have finished.
+  const auto state = get_state();
+  if (!state) return {.error = "No active capture"};
+  auto& out = state->result;
+  if (out.acquire_count != 1 || out.capture_count != 1 || !state->buffer)
+    fail(*state, "Missing actual acquire/capture/buffer");
+  if (out.error.empty()) {
+    // The callback owns State/Buffer, so timeout cannot leave a stack capture.
+    state->buffer.MapAsync(wgpu::MapMode::Read, 0, state->bytes, wgpu::CallbackMode::AllowSpontaneous,
+      [state](wgpu::MapAsyncStatus status, wgpu::StringView) {
+        state->map_ok.store(status == wgpu::MapAsyncStatus::Success, std::memory_order_relaxed);
+        state->map_done.store(true, std::memory_order_release);
+      });
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{5};
+    while (!state->map_done.load(std::memory_order_acquire) && std::chrono::steady_clock::now() < deadline) {
+      webgpu::g_instance.ProcessEvents(); // Dawn only, no SDL/physical input.
+      std::this_thread::sleep_for(std::chrono::milliseconds{1});
+    }
+    if (!state->map_done.load(std::memory_order_acquire)) fail(*state, "Readback deadline expired");
+    else if (!state->map_ok.load(std::memory_order_relaxed)) fail(*state, "Actual readback mapping failed");
+    else {
+      const auto* bytes = static_cast<const uint8_t*>(state->buffer.GetConstMappedRange(0, state->bytes));
+      if (!bytes) fail(*state, "Actual mapped range unavailable");
+      else {
+        out.rgba.resize(size_t(out.width) * out.height * 4u);
+        const bool bgra = out.format == wgpu::TextureFormat::BGRA8Unorm;
+        for (uint32_t y = 0; y < out.height; ++y) {
+          for (uint32_t x = 0; x < out.width; ++x) {
+            const auto* from = bytes + size_t(y) * state->pitch + size_t(x) * 4;
+            auto* to = out.rgba.data() + (size_t(y) * out.width + x) * 4;
+            to[0] = from[bgra ? 2 : 0]; to[1] = from[1];
+            to[2] = from[bgra ? 0 : 2]; to[3] = from[3];
+          }
+        }
+      }
+    }
+    // Also cancels an outstanding map on timeout. The shared callback stays safe.
+    state->buffer.Unmap();
+  }
+  out.ok = out.error.empty();
+  {
+    const std::lock_guard lock{state_mutex};
+    current.reset();
+  }
+  return std::move(out);
+}
+} // namespace aurora::surface_probe
