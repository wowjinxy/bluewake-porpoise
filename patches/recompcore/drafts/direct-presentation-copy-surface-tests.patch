+"""Pre-launch write-target checks for the concrete private compile/link recipe."""
+from pathlib import Path
+import ntpath
+
+def canonical(p):
+    return ntpath.normpath(str(p)).casefold()
+
+def output_paths(argv):
+    # Flatten linker forwarding first; never rely on the spelling/case of -Wl.
+    tokens=[];i=0
+    while i<len(argv):
+        a=argv[i];low=a.casefold()
+        if low=='-xlinker':
+            if i+1>=len(argv):raise RuntimeError('Missing -Xlinker operand')
+            tokens.append(argv[i+1]);i+=2;continue
+        if low.startswith('-wl,'):tokens.extend(a[4:].split(','))
+        else:tokens.append(a)
+        i+=1
+    exact={'-o','-mf','-mt','/out','/pdb','/implib','/reproduce','/manifestfile','/fo'}
+    colon=('/out:','/pdb:','/implib:','/reproduce:','/manifestfile:','/fo:')
+    outputs=[];i=0
+    while i<len(tokens):
+        a=tokens[i];low=a.casefold()
+        if low in exact:
+            if i+1>=len(tokens) or not tokens[i+1]:raise RuntimeError('Missing write operand')
+            outputs.append(tokens[i+1]);i+=2;continue
+        found=False
+        for prefix in colon:
+            if low.startswith(prefix):
+                if not a[len(prefix):]:raise RuntimeError('Empty write operand')
+                outputs.append(a[len(prefix):]);found=True;break
+        if not found:
+            if low.startswith('--output='):outputs.append(a.split('=',1)[1])
+            elif low.startswith(('-mf','-mt')) and len(a)>3:outputs.append(a[3:])
+            elif low.startswith(('/fo','-fo','/fd','/fi','/fa')) and len(a)>3:outputs.append(a[3:])
+        i+=1
+    return outputs
+
+def check_outputs(argv,owned,historical=()):
+    root=canonical(owned).rstrip('\\')+'\\'
+    forbidden={canonical(p) for p in historical}
+    outputs=output_paths(argv)
+    if not outputs:raise RuntimeError('No declared compile/link write targets')
+    for value in outputs:
+        p=Path(value)
+        if not ntpath.isabs(str(p)) or not canonical(p).startswith(root):raise RuntimeError('Write outside fresh owned case: '+value)
+        if canonical(p) in forbidden or p.exists():raise RuntimeError('Pre-existing/historical write target: '+value)
+        # Inspect existing parents without following a reparse directory.
+        for parent in (p,*p.parents):
+            try:s=parent.lstat()
+            except FileNotFoundError:continue
+            if parent.is_symlink() or getattr(s,'st_file_attributes',0)&0x400:raise RuntimeError('Reparse write target/parent')
+    return outputs
+
+def self_test(owned):
+    root=Path(owned);checks=0
+    for prefix in ('/pdb:','/PDB:','/implib:','/IMPLIB:','/reproduce:','/REPRODUCE:','/manifestfile:','/MANIFESTFILE:','/fo:','/FO:'):
+        for form in ('bare','xlinker','wl','WL'):
+            target=str(root/'fresh.bin');flag=prefix+target
+            args=['clang',flag] if form=='bare' else ['clang','-Xlinker',flag] if form=='xlinker' else ['clang','-'+('Wl' if form=='wl' else 'WL')+','+flag]
+            if check_outputs(args,root)!=[target]:raise RuntimeError('Positive output guard specimen')
+            bad=flag.replace(target,str(root.parent/'historical.bin'))
+            badargs=['clang',bad] if form=='bare' else ['clang','-Xlinker',bad] if form=='xlinker' else ['clang','-'+('Wl' if form=='wl' else 'WL')+','+bad]
+            try:check_outputs(badargs,root)
+            except RuntimeError:pass
+            else:raise RuntimeError('Outside output guard specimen')
+            checks+=2
+    for flag in ('-o','-MF','-MT','/FO','/MANIFESTFILE'):
+        p=str(root/'fresh.obj');check_outputs(['clang',flag,p],root);checks+=1
+        try:check_outputs(['clang',flag,p],root,[p])
+        except RuntimeError:pass
+        else:raise RuntimeError('Historical output guard specimen')
+        checks+=1
+    for args in (['clang','-Xlinker'],['clang','-o'],['clang','-Wl,/PDB:']):
+        try:check_outputs(args,root)
+        except RuntimeError:pass
+        else:raise RuntimeError('Missing operand guard specimen')
+        checks+=1
+    return checks
