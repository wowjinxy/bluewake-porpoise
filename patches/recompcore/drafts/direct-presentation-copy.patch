@@ -0,0 +1,88 @@
+#pragma once
+
+#include <webgpu/webgpu_cpp.h>
+#include <cstdlib>
+#include <span>
+
+namespace aurora::webgpu::presentation {
+// Candidate opt-in: keep the established shader path unless the exact value is 1.
+constexpr bool enabled_value(const char* value) noexcept {
+  return value && value[0] == '1' && value[1] == '\0';
+}
+inline bool enabled() noexcept {
+  static const bool value = enabled_value(std::getenv("DOL_AURORA_DIRECT_PRESENT_COPY"));
+  return value;
+}
+
+struct SurfaceOptions {
+  wgpu::TextureUsage usage = wgpu::TextureUsage::RenderAttachment;
+  wgpu::CompositeAlphaMode alpha = wgpu::CompositeAlphaMode::Auto;
+};
+inline SurfaceOptions surface_options(bool optIn, std::span<const wgpu::CompositeAlphaMode> alphaModes,
+                                      wgpu::TextureUsage supportedUsage) noexcept {
+  SurfaceOptions result;
+  if (!optIn || (supportedUsage & wgpu::TextureUsage::CopyDst) == wgpu::TextureUsage::None) {
+    return result;
+  }
+  for (const auto alpha : alphaModes) {
+    if (alpha == wgpu::CompositeAlphaMode::Opaque) {
+      result.usage |= wgpu::TextureUsage::CopyDst;
+      result.alpha = alpha;
+      break;
+    }
+  }
+  return result;
+}
+
+struct TextureInfo {
+  uint32_t width;
+  uint32_t height;
+  uint32_t depth;
+  uint32_t samples;
+  wgpu::TextureFormat format;
+  wgpu::TextureUsage usage;
+  wgpu::TextureDimension dimension;
+};
+struct ViewportInfo {
+  float left;
+  float top;
+  float width;
+  float height;
+};
+constexpr bool copy_format(wgpu::TextureFormat format) noexcept {
+  return format == wgpu::TextureFormat::RGBA8Unorm || format == wgpu::TextureFormat::BGRA8Unorm;
+}
+inline bool compatible(bool optIn, const TextureInfo& source, const TextureInfo& target,
+                       wgpu::CompositeAlphaMode alpha, const ViewportInfo& viewport) noexcept {
+  // Only the resampler's opaque, single-sample full-surface result is eligible.
+  // Letterboxing, composition and format conversion retain the shader fallback.
+  return optIn && alpha == wgpu::CompositeAlphaMode::Opaque && source.width != 0 && source.height != 0 &&
+         source.width == target.width && source.height == target.height && source.depth == 1 && target.depth == 1 &&
+         source.samples == 1 && target.samples == 1 && source.dimension == wgpu::TextureDimension::e2D &&
+         target.dimension == wgpu::TextureDimension::e2D && copy_format(source.format) && source.format == target.format &&
+         (source.usage & wgpu::TextureUsage::CopySrc) != wgpu::TextureUsage::None &&
+         (target.usage & wgpu::TextureUsage::CopyDst) != wgpu::TextureUsage::None &&
+         viewport.left == 0.f && viewport.top == 0.f && viewport.width == static_cast<float>(target.width) &&
+         viewport.height == static_cast<float>(target.height);
+}
+// Query actual texture properties at encoding time, after surface acquisition.
+// The callable encodes one full mip-0/layer-0 copy; no texture handles survive it.
+template <typename Texture, typename Copy>
+bool copy_if_compatible(bool optIn, const Texture& source, const Texture& target,
+                         wgpu::CompositeAlphaMode alpha, const ViewportInfo& viewport, Copy&& copy) {
+  if (!optIn || !source || !target) {
+    return false;
+  }
+  const auto info = [](const Texture& texture) {
+    return TextureInfo{texture.GetWidth(), texture.GetHeight(), texture.GetDepthOrArrayLayers(), texture.GetSampleCount(),
+                       texture.GetFormat(), texture.GetUsage(), texture.GetDimension()};
+  };
+  const auto sourceInfo = info(source);
+  const auto targetInfo = info(target);
+  if (!compatible(optIn, sourceInfo, targetInfo, alpha, viewport)) {
+    return false;
+  }
+  copy(source, target, targetInfo.width, targetInfo.height);
+  return true;
+}
+} // namespace aurora::webgpu::presentation
