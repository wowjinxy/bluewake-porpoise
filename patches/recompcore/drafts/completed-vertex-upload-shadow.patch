diff --git a/GXRuntime/graphics/aurora/lib/gfx/vertex_upload_shadow.hpp b/GXRuntime/graphics/aurora/lib/gfx/vertex_upload_shadow.hpp
new file mode 100644
--- /dev/null
+++ b/GXRuntime/graphics/aurora/lib/gfx/vertex_upload_shadow.hpp
@@ -0,0 +1,182 @@
+#pragma once
+// Adapted from Elliott Tate's unchanged-upload work (39dcacb2e72546bb41b6eaf25b73aa0382742381).
+// The shadow describes completed copies, never speculative recording or submission.
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <vector>
+
+namespace aurora::gfx::vertex_upload {
+struct Resource {
+  uintptr_t object = 0;
+  uint64_t generation = 0;
+  uint32_t capacity = 0;
+  bool operator==(const Resource&) const = default;
+};
+struct Range {
+  uint32_t begin, end;
+  bool operator==(const Range&) const = default;
+};
+struct Counters {
+  uint64_t baseline = 0, planned = 0, submitted = 0, completed = 0;
+  uint64_t reservations = 0, declined = 0, canceled = 0, failed = 0;
+};
+struct Image { Range range; std::vector<uint8_t> bytes; };
+struct Submission {
+  std::vector<Image> images;
+  uint64_t bytes = 0;
+  uint64_t revision = 0;
+  bool done = false, success = false;
+};
+struct State {
+  explicit State(Resource value) : resource(value), bytes(value.capacity), known(value.capacity / 4) {}
+  Resource resource;
+  std::mutex mutex;
+  std::vector<uint8_t> bytes, known;
+  std::deque<std::shared_ptr<Submission>> pending;
+  Counters counters;
+  uint64_t revision = 0;
+};
+inline void require(bool ok) { if (!ok) throw std::logic_error("vertex upload lifetime/range contract"); }
+inline uint64_t size(const std::vector<Range>& ranges) {
+  uint64_t n = 0; for (auto r : ranges) n += r.end - r.begin; return n;
+}
+
+class Token {
+  std::shared_ptr<State> state;
+  std::shared_ptr<Submission> submission;
+  std::vector<Range> copies;
+  uint32_t captured = 0;
+  bool eligible = false, sealed = false, usable = true, terminal = false;
+  void drain_locked() {
+    while (!state->pending.empty() && state->pending.front()->done) {
+      auto front = state->pending.front(); state->pending.pop_front();
+      if (!front->success || front->revision != state->revision) {
+        std::fill(state->known.begin(), state->known.end(), 0);
+        ++state->counters.failed;
+      } else {
+        for (const auto& image : front->images) {
+          std::memcpy(state->bytes.data() + image.range.begin, image.bytes.data(), image.bytes.size());
+          std::fill(state->known.begin() + image.range.begin / 4, state->known.begin() + image.range.end / 4, 1);
+        }
+        state->counters.completed += front->bytes;
+      }
+    }
+  }
+public:
+  explicit Token(std::shared_ptr<State> value) : state(std::move(value)) {
+    std::lock_guard lock(state->mutex);
+    eligible = state->counters.reservations++ == 0;
+    if (!eligible) ++state->counters.declined;
+  }
+  ~Token() { cancel(); }
+  Token(const Token&) = delete;
+  Token& operator=(const Token&) = delete;
+  bool can_compare() const { return eligible; }
+  Resource resource() const { return state->resource; }
+
+  // Called on the recording thread. Only complete words inside the immutable
+  // recorded prefix may be compared; its trailing partial word is always copied.
+  std::vector<Range> plan(const uint8_t* staging, uint32_t highWater) {
+    std::lock_guard lock(state->mutex);
+    require(!sealed && !terminal && highWater >= captured && highWater <= state->resource.capacity);
+    if (highWater == captured) return {};
+    require(staging != nullptr);
+    const uint32_t begin = captured & ~3u, end = (highWater + 3u) & ~3u;
+    require(end <= state->resource.capacity);
+    std::vector<Range> ranges;
+    for (uint32_t at = begin; at < end; at += 4) {
+      const bool same = eligible && usable && at + 4 <= highWater && state->known[at / 4] &&
+                        std::memcmp(staging + at, state->bytes.data() + at, 4) == 0;
+      if (!same) {
+        // Small gaps preserve the donor's batching rule. Bytes in merged gaps
+        // still come from the original staging buffer, including alignment bytes.
+        if (!ranges.empty() && at - ranges.back().end <= 1024) ranges.back().end = at + 4;
+        else ranges.push_back({at, at + 4});
+      }
+    }
+    state->counters.baseline += end - begin;
+    state->counters.planned += size(ranges);
+    copies.insert(copies.end(), ranges.begin(), ranges.end());
+    captured = highWater;
+    return ranges;
+  }
+
+  // Any allocation mismatch declines the optimization and forbids committing
+  // this token's planned image. The caller performs its original full copy.
+  bool matches(Resource actual) {
+    std::lock_guard lock(state->mutex);
+    if (actual == state->resource && usable && !terminal) return true;
+    usable = false;
+    ++state->revision;
+    std::fill(state->known.begin(), state->known.end(), 0);
+    return false;
+  }
+  void seal(const uint8_t* staging, uint32_t capacity) {
+    std::lock_guard lock(state->mutex);
+    require(!sealed && !terminal && capacity == state->resource.capacity && staging != nullptr);
+    submission = std::make_shared<Submission>();
+    for (auto r : copies) {
+      require(r.begin < r.end && r.end <= capacity && !(r.begin & 3) && !(r.end & 3));
+      submission->images.push_back({r, std::vector<uint8_t>(staging + r.begin, staging + r.end)});
+      submission->bytes += r.end - r.begin;
+    }
+    sealed = true;
+  }
+  bool submitted() {
+    std::lock_guard lock(state->mutex);
+    require(sealed && !terminal);
+    if (!usable) return false;
+    require(std::find(state->pending.begin(), state->pending.end(), submission) == state->pending.end());
+    submission->revision = state->revision;
+    state->pending.push_back(submission);
+    state->counters.submitted += submission->bytes;
+    return true;
+  }
+  void complete(bool success) {
+    std::lock_guard lock(state->mutex);
+    if (terminal) return;
+    require(!terminal && submission &&
+            std::find(state->pending.begin(), state->pending.end(), submission) != state->pending.end());
+    submission->done = true; submission->success = success && usable;
+    terminal = true;
+    --state->counters.reservations;
+    // Callback delivery can be out of order. Apply images only in actual queue
+    // submission order; callbacks hold tokens and resource pins through readers.
+    drain_locked();
+  }
+  void cancel() noexcept {
+    if (!state) return;
+    std::lock_guard lock(state->mutex);
+    if (terminal) return;
+    // Also covers an unknown external callback that submitted without the
+    // correlated hook: never infer that an unreported encoder was canceled.
+    std::fill(state->known.begin(), state->known.end(), 0);
+    ++state->revision;
+    if (submission) {
+      auto found = std::find(state->pending.begin(), state->pending.end(), submission);
+      if (found != state->pending.end()) {
+        submission->done = true; submission->success = false;
+      }
+    }
+    terminal = true; --state->counters.reservations; ++state->counters.canceled;
+    drain_locked();
+  }
+};
+
+class Shadow {
+  std::shared_ptr<State> state;
+public:
+  void reset(Resource resource = {}) {
+    require(resource.object == 0 ? resource.generation == 0 && resource.capacity == 0 :
+            resource.generation != 0 && resource.capacity != 0 && !(resource.capacity & 3));
+    state = resource.object ? std::make_shared<State>(resource) : nullptr;
+  }
+  std::shared_ptr<Token> reserve() { require(bool(state)); return std::make_shared<Token>(state); }
+  Counters counters() const { require(bool(state)); std::lock_guard lock(state->mutex); return state->counters; }
+};
+} // namespace aurora::gfx::vertex_upload
