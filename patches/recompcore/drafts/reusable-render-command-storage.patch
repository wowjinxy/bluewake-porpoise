diff --git a/GXRuntime/graphics/aurora/lib/gfx/command_list_pool.hpp b/GXRuntime/graphics/aurora/lib/gfx/command_list_pool.hpp
new file mode 100644
--- /dev/null
+++ b/GXRuntime/graphics/aurora/lib/gfx/command_list_pool.hpp
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+// Command-list reuse adapts elliotttate's 11c1369c56a04de086a053de491f365b7d0274a8.
+// A caller may recycle a list only after its final queued/replayed reader.
+#include <cstddef>
+#include <mutex>
+#include <new>
+#include <utility>
+#include <vector>
+
+namespace aurora::gfx {
+template <class List> class CommandListPool {
+public:
+  static constexpr std::size_t MaxLists = 64;
+  static constexpr std::size_t MaxListBytes = 8 * 1024 * 1024;
+  static constexpr std::size_t MaxBytes = 32 * 1024 * 1024;
+
+  List take(std::size_t reserve) {
+    List list;
+    {
+      std::lock_guard lock{m_mutex};
+      if (!m_lists.empty()) {
+        m_bytes -= m_lists.back().capacity() * sizeof(typename List::value_type);
+        list = std::move(m_lists.back());
+        m_lists.pop_back();
+      }
+    }
+    // Reserve has the same failure semantics as the original pass creation.
+    list.reserve(reserve);
+    return list;
+  }
+
+  void recycle(List& list) {
+    // Release command-owned references before taking the pool lock. Empty
+    // capacity retains no command/resource ownership from the retired frame.
+    list.clear();
+    const auto capacity = list.capacity();
+    if (capacity == 0 || capacity > MaxListBytes / sizeof(typename List::value_type))
+      return;
+    const auto bytes = capacity * sizeof(typename List::value_type);
+    std::lock_guard lock{m_mutex};
+    if (m_lists.size() >= MaxLists || bytes > MaxBytes - m_bytes)
+      return;
+    try {
+      m_lists.push_back(std::move(list));
+      m_bytes += bytes;
+    } catch (const std::bad_alloc&) {
+      // Reuse is optional. The emptied list stays with its retiring packet;
+      // its ordinary packet reset frees it. Do not add a rendering failure.
+    }
+  }
+
+  void clear() {
+    std::lock_guard lock{m_mutex};
+    m_lists.clear();
+    m_bytes = 0;
+  }
+  std::size_t retained_bytes() const {
+    std::lock_guard lock{m_mutex};
+    return m_bytes;
+  }
+  std::size_t retained_lists() const {
+    std::lock_guard lock{m_mutex};
+    return m_lists.size();
+  }
+
+private:
+  mutable std::mutex m_mutex;
+  std::vector<List> m_lists;
+  std::size_t m_bytes = 0;
+};
+} // namespace aurora::gfx
