 static RenderPassList& current_render_passes() { return current_frame_packet().renderPasses; }
 
+// Empty lists are retired only at the existing packet-reset sites: after
+// queued encoding and every interpolation replay, or an acquired free slot.
+static CommandListPool<CommandList> g_commandListPool;
+static CommandList take_command_list(size_t reserve) {
+  return g_commandListPool.take(reserve);
+}
+static void recycle_command_lists(FramePacket& packet) {
+  for (auto& pass : packet.renderPasses)
+    g_commandListPool.recycle(pass.commands);
+}
