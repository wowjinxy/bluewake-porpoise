+int main(){
+ for(unsigned stride:{gx::kCompactVertexFloats,gx::kFullVertexFloats}){
+  gx::DrawPlan p{};p.ok=true;p.vertex_count=6;p.vertex_floats=stride;p.draw_tag=123;p.draw_tag_age=7;p.match_direct_position=true;
