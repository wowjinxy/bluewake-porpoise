+// Shift token that WGSL accepts for the given width. vec: vec3u operand.
+std::string shl(bool vec, unsigned n) {
+  char b[32];
+  std::snprintf(b, sizeof b, vec ? " << vec3u(%uu)" : " << %uu", n);
+  return b;
+}
+std::string shr(bool vec, unsigned n) {
+  char b[32];
+  std::snprintf(b, sizeof b, vec ? " >> vec3u(%uu)" : " >> %uu", n);
+  return b;
+}
