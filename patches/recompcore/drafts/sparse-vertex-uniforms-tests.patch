+void emit(std::string& out, const char* text) { out += text; }
+
+void emitf(std::string& out, const char* fmt, ...) {
+  char buffer[512];
+  va_list args;
+  va_start(args, fmt);
+  std::vsnprintf(buffer, sizeof buffer, fmt, args);
+  va_end(args);
+  out += buffer;
+}
