+bool cc_uses(const TevStageKey& s, std::uint8_t arg) {
+  return s.cc_a == arg || s.cc_b == arg || s.cc_c == arg || s.cc_d == arg;
+}
+bool ac_uses(const TevStageKey& s, std::uint8_t arg) {
