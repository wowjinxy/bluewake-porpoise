+void ConsumingAuroraRenderSink::remember_pending_array(const ConsumedArrayInput& input) {
+  for (std::uint32_t i = 0; i < pending_fusion_.current_array_count; ++i) {
+    if (pending_fusion_.current_arrays[i].attr == input.attr) {
+      pending_fusion_.current_arrays[i] = input;
+      return;
+    }
+  }
+  if (pending_fusion_.current_array_count < ConsumedDraw::kMaxArrays)
+    pending_fusion_.current_arrays[pending_fusion_.current_array_count++] = input;
+}
+
+void ConsumingAuroraRenderSink::clear_pending_fusion() {
+  for (std::uint32_t i = 0; i < pending_fusion_.previous_array_count; ++i)
+    pending_fusion_.previous_arrays[i] = {};
+  for (std::uint32_t i = 0; i < pending_fusion_.current_array_count; ++i)
+    pending_fusion_.current_arrays[i] = {};
+  pending_fusion_.active = false;
+  pending_fusion_.previous_array_count = pending_fusion_.current_array_count = 0;
+}
+
+void ConsumingAuroraRenderSink::split_pending_fusion() {
+  ConsumedDraw& previous = draws_.back();
+  // This copy occurs only on rejected fusion. It keeps the exact common
+  // transform/texture snapshot and owns the latest primitive's payload.
+  ConsumedDraw current = previous;
+  current.sequence = pending_fusion_.sequence;
+  current.primitive = pending_fusion_.primitive;
+  current.vertex_count = pending_fusion_.vertex_count;
+  current.vertex_payload.erase(current.vertex_payload.begin(),
+      current.vertex_payload.begin() + pending_fusion_.previous_payload);
+  current.segments.clear();
+  current.transform_flags = pending_fusion_.current_flags;
+  current.payload_pn_matrix_mask = pending_fusion_.current_pn_mask;
+  current.array_input_count = pending_fusion_.current_array_count;
+  for (std::uint32_t i = 0; i < ConsumedDraw::kMaxArrays; ++i)
+    current.arrays[i] = i < current.array_input_count ? pending_fusion_.current_arrays[i] : ConsumedArrayInput{};
+
+  for (std::uint32_t i = 0; i < previous.array_input_count; ++i)
+    untally_array_input(previous.arrays[i].resolved);
+  previous.vertex_count = pending_fusion_.previous_vertices;
+  previous.vertex_payload.resize(pending_fusion_.previous_payload);
+  previous.segments.resize(pending_fusion_.previous_segments);
+  previous.transform_flags = pending_fusion_.previous_flags;
+  previous.payload_pn_matrix_mask = pending_fusion_.previous_pn_mask;
+  previous.array_input_count = pending_fusion_.previous_array_count;
+  for (std::uint32_t i = 0; i < ConsumedDraw::kMaxArrays; ++i)
+    previous.arrays[i] = i < previous.array_input_count ? pending_fusion_.previous_arrays[i] : ConsumedArrayInput{};
+  for (std::uint32_t i = 0; i < previous.array_input_count; ++i)
+    tally_array_input(previous.arrays[i].resolved);
+  accumulate_assembly(previous, total_draws_ - 1u);
+  previous = std::move(current);
+  back_assembled_ = false;
+  for (std::uint32_t i = 0; i < previous.array_input_count; ++i)
+    tally_array_input(previous.arrays[i].resolved);
+  --fused_draws_;
+  clear_pending_fusion();
+}
