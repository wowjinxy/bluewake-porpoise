+inline constexpr std::uint32_t kConstantsInBetween = 0x80000000u;
+// Staging offsets are 16-byte aligned and bounded by their owned buffers.
+inline constexpr std::uint32_t constant_row(std::uint32_t offset, bool between) noexcept {
+  return offset / 16u | (between ? kConstantsInBetween : 0u);
