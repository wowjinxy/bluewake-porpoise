+          DOL_GUEST_ADDRESS_AUTO, DOL_GUEST_RESOURCE_VERTEX_ARRAY, &range) ||
+        range.data == nullptr || range.available < input.span_size ||
+        std::memcmp(range.data, input.owned_data->data(), input.span_size) != 0)
+      return false;
+  }
+  return true;
+}
