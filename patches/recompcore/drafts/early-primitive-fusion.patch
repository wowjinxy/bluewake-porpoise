+bool ConsumingAuroraRenderSink::arrays_unchanged(const ConsumedDraw& draw) const {
+  for (std::uint32_t i = 0; i < draw.array_input_count; ++i) {
+    const ConsumedArrayInput& input = draw.arrays[i];
+    if (!input.owned_data || input.owned_data->size() != input.span_size || resolver_ == nullptr)
