+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+
+namespace aurora::gfx::preload {
+
+enum class Result {
+  Pending,
+  Complete,
+  Timeout,
+  Stopped,
+  Reinitialized,
+  CacheFailure,
+  NullPipeline,
+  AccountingFailure,
+};
+
+struct State {
+  bool loadingClosed;
+  bool queuesEmpty;
+  bool pendingEmpty;
+  bool stopped;
+  bool cacheFailed;
+};
+
+struct Lifetime {
+  bool workers;
+  bool priorityQueue;
+  bool backgroundQueue;
+  bool pending;
+  bool fenceEnabled;
+  bool inFlight;
+  bool cacheQueued;
+  bool pipelines;
+  bool writer;
+};
+
+inline bool lifetime_busy(Lifetime state) {
+  return state.workers || state.priorityQueue || state.backgroundQueue || state.pending ||
+         state.fenceEnabled || state.inFlight || state.cacheQueued || state.pipelines || state.writer;
+}
+
+struct Ticket {
+  uint64_t generation = 0;
+  bool tracked = false;
+};
+
+// Every operation except notify() uses the caller's existing pipeline mutex.
+// The class never owns that mutex or invokes a GPU operation while holding it.
+class Fence {
+  std::condition_variable m_ready;
+  uint64_t m_generation = 0;
+  uint64_t m_inFlight = 0;
+  uint64_t m_completed = 0;
+  bool m_enabled = false;
+  Result m_failure = Result::Pending;
+
+public:
+  void begin() {
+    ++m_generation;
+    m_inFlight = 0;
+    m_completed = 0;
+    m_enabled = true;
+    m_failure = Result::Pending;
+  }
+
+  bool enabled() const { return m_enabled; }
+  uint64_t in_flight() const { return m_inFlight; }
+  uint64_t completed() const { return m_completed; }
+
+  Ticket take() {
+    if (!m_enabled)
+      return {};
+    ++m_inFlight;
+    return {m_generation, true};
+  }
+
+  void note_result(Ticket ticket, bool valid) {
+    if (ticket.tracked && ticket.generation == m_generation && !valid)
+      m_failure = Result::NullPipeline;
+  }
+
+  void finish(Ticket ticket) {
+    if (!ticket.tracked || ticket.generation != m_generation)
+      return;
+    if (m_inFlight == 0) {
+      m_failure = Result::AccountingFailure;
+      return;
+    }
+    --m_inFlight;
+    ++m_completed;
+  }
+
+  // Shutdown calls this only after its workers are joined. Wakes an older
+  // waiter without allowing its generation to certify a later initialization.
+  void invalidate() {
+    ++m_generation;
+    m_enabled = false;
+    m_inFlight = 0;
+  }
+
+  void notify() { m_ready.notify_all(); }
+
+  template <typename Query>
+  Result wait(std::unique_lock<std::mutex>& lock,
+              std::chrono::steady_clock::time_point deadline, Query query) {
+    const uint64_t generation = m_generation;
+    Result result = Result::Pending;
+    const auto evaluate = [&] {
+      const State state = query();
+      if (generation != m_generation)
+        result = Result::Reinitialized;
+      else if (state.stopped)
+        result = Result::Stopped;
+      else if (state.cacheFailed)
+        result = Result::CacheFailure;
+      else if (m_failure != Result::Pending)
+        result = m_failure;
+      else if (state.loadingClosed && state.queuesEmpty && state.pendingEmpty && m_inFlight == 0)
+        result = Result::Complete;
+      return result != Result::Pending;
+    };
+    if (!m_ready.wait_until(lock, deadline, evaluate))
+      return Result::Timeout;
+    if (result == Result::Complete)
+      m_enabled = false;
+    return result;
+  }
+};
+
+} // namespace aurora::gfx::preload
