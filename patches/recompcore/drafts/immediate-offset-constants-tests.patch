+++ b/tests/performance_immediate_constants/CMakeLists.txt
@@ -0,0 +1,32 @@
+cmake_minimum_required(VERSION 3.20)
+project(immediate_constants_cpu_test CXX)
+if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+  message(FATAL_ERROR "The qualification fixture requires Clang")
+endif()
+set(GX_RUNTIME "" CACHE PATH "Candidate GXRuntime directory")
+if(NOT EXISTS "${GX_RUNTIME}/graphics/aurora/lib/gfx/immediate_constants.hpp")
+  message(FATAL_ERROR "Set GX_RUNTIME to the candidate GXRuntime directory")
+endif()
+option(IMMEDIATE_ASAN "Instrument all fixture and shader translation units" OFF)
+add_executable(immediate_constants_test immediate_constants_test.cpp
+  "${GX_RUNTIME}/graphics/gxcore/src/gxcore_shader.cpp"
+  "${GX_RUNTIME}/graphics/gxcore/src/gxcore_uber.cpp")
+target_compile_features(immediate_constants_test PRIVATE cxx_std_20)
+target_include_directories(immediate_constants_test PRIVATE
+  "${GX_RUNTIME}/graphics/gxcore/include" "${GX_RUNTIME}/graphics/aurora/lib/gfx")
+target_compile_options(immediate_constants_test PRIVATE -O3 -UNDEBUG -Wall -Wextra -Wno-unused-function)
+if(WIN32)
+  target_compile_options(immediate_constants_test PRIVATE -fms-compatibility-version=19.44 -fms-runtime-lib=dll)
+  target_link_options(immediate_constants_test PRIVATE -fms-runtime-lib=dll)
+endif()
+if(IMMEDIATE_ASAN)
+  target_compile_options(immediate_constants_test PRIVATE -fsanitize=address -fno-omit-frame-pointer)
+  target_link_options(immediate_constants_test PRIVATE -fsanitize=address)
+  if(WIN32)
+    target_compile_options(immediate_constants_test PRIVATE -shared-libasan)
+    target_link_options(immediate_constants_test PRIVATE -shared-libasan)
+  endif()
+endif()
+enable_testing()
+add_test(NAME immediate_constants_cpu COMMAND immediate_constants_test)
+set_tests_properties(immediate_constants_cpu PROPERTIES TIMEOUT 300)
