diff --git a/GXRuntime/graphics/aurora/lib/gfx/efb_color_peek.hpp b/GXRuntime/graphics/aurora/lib/gfx/efb_color_peek.hpp
new file mode 100644
--- /dev/null
+++ b/GXRuntime/graphics/aurora/lib/gfx/efb_color_peek.hpp
@@ -0,0 +1,140 @@
+#pragma once
+
+// Channel quantization adapted from Dolphin's
+// Source/Core/VideoCommon/VideoCommon.h.
+// Copyright 2008 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace aurora::gfx::efb_color_peek {
+
+// CPU peeks sample pixel centers, never a filtered resize of the alpha IDs.
+struct Mapping {
+  uint32_t width = 0, height = 0;
+  uint32_t logicalWidth = 0, logicalHeight = 0;
+  double scaleX = 1.0, scaleY = 1.0, offsetX = 0.0, offsetY = 0.0;
+};
+
+inline Mapping make_mapping(uint32_t width, uint32_t height, uint32_t logicalWidth,
+                            uint32_t logicalHeight, bool native, bool stretch) noexcept {
+  Mapping m{width, height, logicalWidth, logicalHeight};
+  if (native) {
+    m.logicalWidth = width;
+    m.logicalHeight = height;
+  } else if (logicalWidth != 0 && logicalHeight != 0) {
+    m.scaleX = double(width) / logicalWidth;
+    m.scaleY = double(height) / logicalHeight;
+    if (!stretch) {
+      const auto scale = m.scaleX < m.scaleY ? m.scaleX : m.scaleY;
+      m.scaleX = m.scaleY = scale;
+      m.offsetX = (double(width) - logicalWidth * scale) * 0.5;
+      m.offsetY = (double(height) - logicalHeight * scale) * 0.5;
+    }
+  }
+  return m;
+}
+
+inline bool map_pixel(const Mapping& m, uint16_t x, uint16_t y, size_t& index) noexcept {
+  if (m.width == 0 || m.height == 0 || x >= m.logicalWidth || y >= m.logicalHeight ||
+      !std::isfinite(m.scaleX) || !std::isfinite(m.scaleY) || !std::isfinite(m.offsetX) ||
+      !std::isfinite(m.offsetY) || m.scaleX <= 0 || m.scaleY <= 0)
+    return false;
+  const auto sx = std::floor(m.offsetX + (double(x) + 0.5) * m.scaleX);
+  const auto sy = std::floor(m.offsetY + (double(y) + 0.5) * m.scaleY);
+  if (sx < 0 || sy < 0 || sx >= m.width || sy >= m.height)
+    return false;
+  index = size_t(sy) * m.width + size_t(sx);
+  return true;
+}
+
+// The PE returns 0xAARRGGBB. Pixel-format quantization precedes alpha-read
+// override; the register's enable/reserved bits do not change its two mode bits.
+inline bool pack_argb(const uint8_t* rgba, uint32_t pixelFormat, uint16_t alphaRead,
+                      uint32_t& out) noexcept {
+  if (rgba == nullptr || pixelFormat > 2 || (alphaRead & 3u) == 3u)
+    return false;
+  uint32_t color = (uint32_t(rgba[3]) << 24) | (uint32_t(rgba[0]) << 16) |
+                   (uint32_t(rgba[1]) << 8) | uint32_t(rgba[2]);
+  if (pixelFormat == 1) {
+    color &= 0xFCFCFCFCu;
+    color |= (color >> 6) & 0x03030303u;
+  } else if (pixelFormat == 2) {
+    color &= 0x00F8FCF8u;
+    color |= (color >> 5) & 0x00070007u;
+    color |= (color >> 6) & 0x00000300u;
+  }
+  if (pixelFormat != 1 || (alphaRead & 3u) == 1u)
+    color |= 0xFF000000u;
+  if ((alphaRead & 3u) == 0u)
+    color &= 0x00FFFFFFu;
+  out = color;
+  return true;
+}
+
+struct Snapshot {
+  Mapping mapping;
+  std::vector<uint8_t> rgba;
+};
+
+struct Revision {
+  uint64_t fifoBytes = 0, frame = 0;
+  uint32_t pixelFormat = 0;
+  bool operator==(const Revision& rhs) const noexcept {
+    return fifoBytes == rhs.fifoBytes && frame == rhs.frame && pixelFormat == rhs.pixelFormat;
+  }
+};
+
+// Only the common renderer's live frame identity proves recording survived a
+// preserving submission. Never open a frame here or change a live frame's flags.
+inline void close_lost_recording_frame(uint64_t frame, bool& frameOpen,
+                                       bool& recordingOpen) noexcept {
+  if (frame == 0)
+    frameOpen = recordingOpen = false;
+}
+
+// A failed attempt is cached too: a recognition loop must not wait for the
+// five-second GPU timeout for every pixel of the same unchanged pass.
+class Cache {
+public:
+  bool matches_stream(uint64_t fifoBytes, uint64_t frame) const noexcept {
+    return attempted_ && revision_.fifoBytes == fifoBytes && revision_.frame == frame;
+  }
+  bool needs_capture(const Revision& revision) const noexcept {
+    return !attempted_ || !(revision_ == revision);
+  }
+  void finish(const Revision& revision, Snapshot snapshot) noexcept {
+    revision_ = revision;
+    attempted_ = true;
+    snapshot_ = std::move(snapshot);
+    const auto& m = snapshot_.mapping;
+    ready_ = m.width != 0 && m.height != 0 &&
+             uint64_t(m.width) * m.height <= 32u * 1024u * 1024u &&
+             snapshot_.rgba.size() == uint64_t(m.width) * m.height * 4u;
+    if (!ready_)
+      snapshot_.rgba.clear();
+  }
+  void reset() noexcept {
+    attempted_ = ready_ = false;
+    snapshot_.rgba.clear();
+  }
+  bool read(uint16_t x, uint16_t y, uint16_t alphaRead, uint32_t& out) const noexcept {
+    size_t index = 0;
+    return ready_ && map_pixel(snapshot_.mapping, x, y, index) &&
+           pack_argb(snapshot_.rgba.data() + index * 4u, revision_.pixelFormat, alphaRead, out);
+  }
+private:
+  bool attempted_ = false, ready_ = false;
+  Revision revision_;
+  Snapshot snapshot_;
+};
+
+// Recording thread only, after the FIFO has drained and while its recording
+// mutex is held. Captures the current EFB, submits without a present/clear,
+// then waits for the ordered GPU map. Empty output is failure, never stale data.
+bool capture(Snapshot& out);
+} // namespace aurora::gfx::efb_color_peek
