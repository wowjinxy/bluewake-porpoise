+#include "efb_color_peek.hpp"
+#include "common.hpp"
+#include "../gx/gx.hpp"
+#include "../dolphin/vi/vi_internal.hpp"
+
+namespace aurora::gfx::efb_color_peek {
+bool capture(Snapshot& out) {
+  out = {};
+  uint32_t width = 0, height = 0;
+  const auto logical = vi::configured_fb_size();
+  const auto policy = gx::g_gxState.viewportPolicy;
+  auto rgba = read_current_efb_rgba8(width, height);
+  if (rgba.empty())
+    return false;
+  out.mapping = make_mapping(width, height, logical.x, logical.y,
+      policy == AURORA_VIEWPORT_NATIVE, policy == AURORA_VIEWPORT_STRETCH);
+  out.rgba = std::move(rgba);
+  return true;
+}
+} // namespace aurora::gfx::efb_color_peek
