+// Pure EFB peek conversion, coordinate and revision checks. No device/window.
+#include "../lib/gfx/efb_color_peek.hpp"
+#include "../lib/gfx/staging_budget.hpp"
+
+#include <cstdio>
+#include <limits>
+
+namespace cp = aurora::gfx::efb_color_peek;
+static unsigned checks = 0, failures = 0;
+#define CHECK(c) do { ++checks; if (!(c)) { ++failures; \
+  std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #c); } } while (0)
+
+static cp::Snapshot one_pixel(uint8_t alpha) {
+  return {cp::make_mapping(1, 1, 1, 1, true, false), {0x12, 0x34, 0x56, alpha}};
+}
+
+static void packing() {
+  uint32_t out = 0;
+  const uint8_t rgba[]{0x12, 0x34, 0x56, 0x94};
+  CHECK(cp::pack_argb(rgba, 1, 6, out) && out == 0x96103455u);
+  CHECK(cp::pack_argb(rgba, 1, 5, out) && out == 0xFF103455u);
+  CHECK(cp::pack_argb(rgba, 1, 4, out) && out == 0x00103455u);
+  CHECK(cp::pack_argb(rgba, 0, 6, out) && out == 0xFF123456u);
+  CHECK(cp::pack_argb(rgba, 0, 4, out) && out == 0x00123456u);
+  CHECK(cp::pack_argb(rgba, 2, 6, out) && out == 0xFF103452u);
+  CHECK(cp::pack_argb(rgba, 2, 4, out) && out == 0x00103452u);
+  out = 0x12345678u;
+  CHECK(!cp::pack_argb(rgba, 3, 6, out) && out == 0x12345678u);
+  CHECK(!cp::pack_argb(rgba, 1, 7, out) && out == 0x12345678u);
+  CHECK(!cp::pack_argb(nullptr, 1, 6, out) && out == 0x12345678u);
+  for (unsigned id = 0; id < 64; ++id) {
+    const uint8_t pixel[]{255, 127, 0, uint8_t(id * 4)};
+    CHECK(cp::pack_argb(pixel, 1, 6, out) && (out >> 26) == id);
+    CHECK(cp::pack_argb(pixel, 1, 0xFFFEu, out) && (out >> 26) == id);
+  }
+  // Independent per-channel bit replication, including all discarded bits.
+  for (unsigned byte = 0; byte < 256; ++byte) {
+    const uint8_t pixel[]{uint8_t(byte), uint8_t(byte), uint8_t(byte), uint8_t(byte)};
+    const auto six = ((byte >> 2) << 2) | (byte >> 6);
+    const auto five = ((byte >> 3) << 3) | (byte >> 5);
+    CHECK(cp::pack_argb(pixel, 1, 2, out) &&
+          out == (six << 24 | six << 16 | six << 8 | six));
+    CHECK(cp::pack_argb(pixel, 2, 2, out) &&
+          out == (0xFF000000u | five << 16 | six << 8 | five));
+  }
+}
+
+static void mapping() {
+  size_t i = size_t(-1);
+  auto m = cp::make_mapping(640, 528, 640, 528, true, false);
+  CHECK(cp::map_pixel(m, 0, 0, i) && i == 0);
+  CHECK(cp::map_pixel(m, 639, 527, i) && i == 640u * 528u - 1u);
+  CHECK(!cp::map_pixel(m, 640, 0, i));
+  CHECK(!cp::map_pixel(m, 0, 528, i));
+  m = cp::make_mapping(1920, 1584, 640, 528, false, true);
+  CHECK(cp::map_pixel(m, 0, 0, i) && i == 1921);
+  CHECK(cp::map_pixel(m, 639, 527, i) && i == 1582u * 1920u + 1918u);
+  m = cp::make_mapping(1000, 600, 640, 480, false, false);
+  CHECK(cp::map_pixel(m, 0, 0, i) && i == 100);
+  CHECK(cp::map_pixel(m, 639, 479, i) && i == 599u * 1000u + 899u);
+  CHECK(!cp::map_pixel(m, 640, 479, i));
+  m = cp::make_mapping(3, 1, 2, 1, false, true);
+  CHECK(cp::map_pixel(m, 0, 0, i) && i == 0);
+  CHECK(cp::map_pixel(m, 1, 0, i) && i == 2);
+  m.scaleX = std::numeric_limits<double>::quiet_NaN();
+  CHECK(!cp::map_pixel(m, 0, 0, i));
+  m.scaleX = std::numeric_limits<double>::infinity();
+  CHECK(!cp::map_pixel(m, 0, 0, i));
+  m.scaleX = 1; m.offsetX = -2;
+  CHECK(!cp::map_pixel(m, 0, 0, i));
+  m = cp::make_mapping(0, 1, 2, 1, false, true);
+  CHECK(!cp::map_pixel(m, 0, 0, i));
+}
+
+static void caching() {
+  cp::Cache cache;
+  cp::Revision r{100, 1, 1};
+  uint32_t out = 0x12345678u;
+  CHECK(cache.needs_capture(r));
+  CHECK(!cache.matches_stream(r.fifoBytes, r.frame));
+  CHECK(!cache.read(0, 0, 6, out) && out == 0x12345678u);
+  unsigned attempts = 0;
+  for (unsigned pixel = 0; pixel < 1000; ++pixel) {
+    if (cache.needs_capture(r)) { ++attempts; cache.finish(r, one_pixel(37 * 4)); }
+    CHECK(cache.read(0, 0, 6, out) && (out >> 26) == 37);
+  }
+  CHECK(attempts == 1);
+  CHECK(cache.matches_stream(r.fifoBytes, r.frame));
+  CHECK(!cache.matches_stream(r.fifoBytes + 1, r.frame));
+  CHECK(!cache.matches_stream(r.fifoBytes, r.frame + 1));
+  CHECK(cache.read(0, 0, 4, out) && (out >> 24) == 0);
+  CHECK(cache.read(0, 0, 5, out) && (out >> 24) == 255);
+  CHECK(!cache.needs_capture(r));
+  ++r.fifoBytes;
+  CHECK(cache.needs_capture(r));
+  cache.finish(r, {}); // actual timeout/failure is remembered, never stale ID37
+  CHECK(cache.matches_stream(r.fifoBytes, r.frame));
+  out = 0x12345678u;
+  for (unsigned pixel = 0; pixel < 1000; ++pixel) {
+    CHECK(!cache.needs_capture(r));
+    CHECK(!cache.read(0, 0, 6, out) && out == 0x12345678u);
+  }
+  ++r.frame;
+  CHECK(cache.needs_capture(r));
+  cache.finish(r, one_pixel(63 * 4));
+  CHECK(cache.read(0, 0, 6, out) && (out >> 26) == 63);
+  r.pixelFormat = 0;
+  CHECK(cache.needs_capture(r));
+  cache.finish(r, one_pixel(0));
+  CHECK(cache.read(0, 0, 6, out) && (out >> 24) == 255);
+  cache.reset();
+  CHECK(cache.needs_capture(r) && !cache.read(0, 0, 6, out));
+  auto malformed = one_pixel(0);
+  malformed.rgba.pop_back();
+  cache.finish(r, std::move(malformed));
+  CHECK(!cache.needs_capture(r) && !cache.read(0, 0, 6, out));
+  malformed = one_pixel(0);
+  malformed.mapping.width = malformed.mapping.height = 0xFFFFFFFFu;
+  cache.finish(r, std::move(malformed));
+  CHECK(!cache.read(0, 0, 6, out));
+}
+
+static void recording_failure() {
+  bool frameOpen = true, recordingOpen = true;
+  cp::close_lost_recording_frame(91, frameOpen, recordingOpen);
+  CHECK(frameOpen && recordingOpen); // failed readback, live continued frame
+  cp::close_lost_recording_frame(0, frameOpen, recordingOpen);
+  CHECK(!frameOpen && !recordingOpen); // failed staging map, no continued frame
+  cp::close_lost_recording_frame(92, frameOpen, recordingOpen);
+  CHECK(!frameOpen && !recordingOpen); // reopening is the backend's responsibility
+  frameOpen = true;
+  cp::close_lost_recording_frame(0, frameOpen, recordingOpen);
+  CHECK(!frameOpen && !recordingOpen);
+
+  cp::Cache cache;
+  const cp::Revision failed{200, 0, 1};
+  cache.finish(failed, {});
+  CHECK(!cache.needs_capture(failed));
+  uint32_t out = 0x12345678u;
+  CHECK(!cache.read(0, 0, 6, out) && out == 0x12345678u);
+  const cp::Revision reopened{200, 93, 1};
+  CHECK(cache.needs_capture(reopened));
+  cache.finish(reopened, one_pixel(17 * 4));
+  CHECK(cache.read(0, 0, 6, out) && (out >> 26) == 17);
+}
+
+static void copy_headroom() {
+  // A draw may fit with finish headroom while the copy's aligned UV does not.
+  aurora::gfx::StagingLimits limits{};
+  limits.capacity.uniforms = 1024;
+  limits.uniformAlignment = 256;
+  limits.storageAlignment = 1;
+  limits.finishUniformHeadroom = 128;
+  aurora::gfx::StagingUse used{};
+  used.uniforms = 769;
+  const aurora::gfx::StagingRequest copy{0, 0, 16, 0, 0};
+  // The previous draw has retained its promised finish-only room.
+  CHECK(used.uniforms + limits.finishUniformHeadroom <= limits.capacity.uniforms);
+  CHECK(!aurora::gfx::staging_fits(used, copy, limits));
+  used.uniforms = 768;
+  CHECK(aurora::gfx::staging_fits(used, copy, limits));
+  used.uniforms = 0; // preserving segmentation resets the mapped staging use
+  CHECK(aurora::gfx::staging_fits(used, copy, limits));
+  limits.capacity.uniforms = 143; // 16 UV bytes plus 128 finish bytes cannot fit
+  CHECK(!aurora::gfx::staging_fits(used, copy, limits));
+}
+
+int main() {
+  packing(); mapping(); caching(); recording_failure(); copy_headroom();
+  std::printf("EFB color peek: %u checks, %u failures\n", checks, failures);
+  return failures == 0 ? 0 : 1;
+}
