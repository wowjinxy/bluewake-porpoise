+    if (!segment_frame() || !staging_has_capacity(0, 0, peekUniformSize, 0, 0))
+      return {};
+  }
+  const auto size = current_render_passes()[g_currentRenderPass].targetSize;
+  // Bound both the CPU allocation and padded GPU readback; row arithmetic in
+  // read_texture_rgba8 stays within u32. This does not widen any guest range.
+  if (size.width == 0 || size.height == 0 || size.width > 8192 || size.height > 8192 ||
+      uint64_t(size.width) * size.height > 32u * 1024u * 1024u)
+    return {};
+  const auto texture = new_render_texture(size.width, size.height, GX_TF_RGBA8, "CPU EFB color peek");
+  if (!texture || !texture->texture)
+    return {};
+  // Same-sized copy after the active pass's resolve. No texture conversion,
+  // scaling filter, copy-clear, display copy, or present-source substitution.
+  resolve_pass(texture, {0, 0, int32_t(size.width), int32_t(size.height)},
+               false, false, false, {}, 0.f);
