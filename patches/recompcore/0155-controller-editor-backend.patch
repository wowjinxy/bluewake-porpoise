+void PADRefreshControllers() {
+  if ((SDL_WasInit(SDL_INIT_GAMEPAD) & SDL_INIT_GAMEPAD) == 0) {
+    return;
+  }
+  int count = 0;
+  SDL_JoystickID* ids = SDL_GetGamepads(&count);
+  if (ids == nullptr) {
+    return;
+  }
+  // Reconcile on the event/game thread, before consumers obtain map pointers.
+  for (auto it = aurora::input::g_GameControllers.begin(); it != aurora::input::g_GameControllers.end();) {
+    const auto instance = it->first;
+    ++it;
+    if (std::find(ids, ids + count, instance) == ids + count) {
+      aurora::input::remove_controller(instance);
+    }
+  }
+  for (int i = 0; i < count; ++i) {
+    aurora::input::add_controller(ids[i]);
+  }
+  SDL_free(ids);
+}
